{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "infra/alchemy/alchemy.run.ts",
    "infra/alchemy/aws.ts",
    "infra/turbo-cache/aws.ts",
    "apps/backend/src/cloudflare/worker.ts",
    "apps/backend/src/bun/*.ts",
    "apps/backend/scripts/*.ts",
    "apps/backend/src/**/*.test.ts",
    "apps/backend/test/**/*.ts",
    "apps/ui/src/main.tsx",
    "apps/ui/src/**/*.stories.tsx",
    "apps/ui/.storybook/**/*.{ts,tsx}",
    "apps/ui/vite.config.ts",
    "apps/ui/vite.shared.ts",
    "apps/ui/vitest.config.ts",
    "packages/http-routing/src/index.ts",
    "packages/coffee/domain/src/**/*.test.ts",
    "packages/coffee/application/src/**/*.test.ts",
    "packages/ui-kit/src/**/*.stories.tsx",
    "packages/coffee/backend/src/index.ts",
    "packages/coffee/presentation/actions/src/index.ts",
    "packages/coffee/presentation/actions/src/**/*.test.ts",
    "packages/coffee/external/in-memory/src/index.ts",
    "packages/coffee/external/sqlite/src/index.ts",
    "packages/coffee/external/sqlite/src/bun/live.ts",
    "packages/coffee/external/sqlite/src/cloudflare/live.ts",
    "packages/coffee/runtime/aws/src/**/*.test.ts",
    "packages/coffee/runtime/cloudflare/src/**/*.test.ts",
  ],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/*.generated.ts",
    "**/dist/**",
    "**/storybook-static/**",
    "packages/coffee/external/sqlite/src/sql/migrations/.generated/**",
    "packages/coffee/external/sqlite/src/sql/queries/.generated/**",
  ],
  // Fallow does not discover the aliased React JavaScript plugins in Oxlint JSON,
  // and @shadcn/lint is loaded by the UI Oxlint configuration rather than source imports.
  // The Alchemy workspace builds the UI by path (`Cloudflare.Website.Vite`) rather than
  // importing it; the dependency exists so Turbo hashes UI changes into the smoke test.
  "ignoreDependencies": [
    // Loaded indirectly by @vitejs/plugin-react's reactCompilerPreset in vite.shared.ts.
    "babel-plugin-react-compiler",
    "oxlint-tsgolint",
    "@shadcn/lint",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "@effect-coffee-shop/web",
  ],
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "off",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "warn",
    "coverage-gaps": "off",
    "feature-flags": "warn",
    "stale-suppressions": "warn",
    "unused-catalog-entries": "warn",
    "empty-catalog-groups": "warn",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "warn",
    "misconfigured-dependency-overrides": "error",
    // No rule packs are configured; state that the policy detector is intentionally unused.
    "policy-violation": "off",
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 3,
    "threshold": 14.5,
    "ignoreImports": true,
    "ignore": [
      "apps/ui/src/**/*.stories.tsx",
      "packages/ui-kit/src/**/*.stories.tsx",
      "packages/coffee/external/drizzle-postgres/src/db/auth-schema.ts",
      "packages/coffee/external/drizzle-postgres/src/db/schema.ts",
    ],
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 500,
    "maxUnitSize": 60,
  },
  "typeAware": {
    "enabled": true,
    "projects": [
      "packages/tooling/tsconfig.json",
      "packages/coffee/testing/tsconfig.json",
      "apps/backend/tsconfig.json",
      "apps/ui/tsconfig.app.json",
      "apps/ui/tsconfig.node.json",
      "packages/turbo-cache/tsconfig.json",
      "packages/http-routing/tsconfig.json",
      "packages/coffee/domain/tsconfig.json",
      "packages/coffee/application/tsconfig.json",
      "packages/ui-kit/tsconfig.json",
      "packages/coffee/auth/tsconfig.json",
      "packages/coffee/backend/tsconfig.json",
      "packages/coffee/presentation/mcp/tsconfig.json",
      "packages/coffee/presentation/cli/tsconfig.json",
      "packages/coffee/presentation/http/tsconfig.json",
      "packages/coffee/presentation/actions/tsconfig.json",
      "packages/coffee/external/sqlite/tsconfig.json",
      "packages/coffee/external/drizzle-postgres/tsconfig.json",
      "packages/coffee/external/in-memory/tsconfig.json",
      "packages/coffee/runtime/cloudflare/tsconfig.json",
      "packages/coffee/runtime/shared/tsconfig.json",
      "packages/coffee/runtime/bun/tsconfig.json",
      "packages/coffee/runtime/aws/tsconfig.json",
      "infra/alchemy/tsconfig.json",
      "infra/turbo-cache/tsconfig.json",
    ],
    "require": "complete",
  },
  "audit": {
    "gate": "new-only",
    "healthBaseline": ".fallow/health-baseline.json",
    "typeAware": false,
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "**/*.test.ts",
          "**/test-support.ts",
          "apps/backend/scripts/**",
          "apps/backend/test/**",
        ],
      },
      {
        "name": "tooling",
        "patterns": [
          "packages/tooling/**",
          "**/oxlint.config.ts",
          "**/vitest.config.ts",
          "**/vitest.setup.ts",
          "apps/ui/vite*.ts",
          "**/drizzle.config.ts",
          "**/sqlfu.config.ts",
          "apps/ui/.storybook/**",
        ],
      },
      {
        "name": "testing",
        "patterns": ["packages/coffee/testing/**"],
      },
      {
        "name": "infra",
        "patterns": ["infra/**"],
      },
      {
        "name": "ui-kit",
        "patterns": ["packages/ui-kit/**"],
      },
      {
        "name": "ui",
        "patterns": ["apps/ui/**"],
      },
      {
        "name": "backend-app",
        "patterns": ["apps/backend/**"],
      },
      {
        "name": "http-routing",
        "patterns": ["packages/http-routing/**"],
      },
      {
        "name": "backend-composition",
        "patterns": ["packages/coffee/backend/**"],
      },
      {
        "name": "runtime",
        "patterns": ["packages/coffee/runtime/**"],
      },
      {
        "name": "domain",
        "patterns": ["packages/coffee/domain/**"],
      },
      {
        "name": "application",
        "patterns": ["packages/coffee/application/**"],
      },
      {
        "name": "actions",
        "patterns": ["packages/coffee/presentation/actions/**"],
      },
      {
        "name": "auth",
        "patterns": ["packages/coffee/auth/**"],
      },
      {
        "name": "external",
        "patterns": ["packages/coffee/external/**"],
      },
      {
        "name": "presentation",
        "patterns": ["packages/coffee/presentation/**"],
      },
      {
        "name": "turbo-cache",
        "patterns": ["packages/turbo-cache/**"],
      },
    ],
    "rules": [
      {
        "from": "testing",
        "allow": ["domain", "application"],
      },
      {
        "from": "infra",
        "allow": ["backend-app", "ui", "external", "runtime", "turbo-cache"],
      },
      {
        "from": "ui-kit",
        "allow": [],
      },
      {
        "from": "ui",
        "allow": ["ui-kit"],
      },
      {
        "from": "backend-app",
        "allow": [
          "http-routing",
          "backend-composition",
          "runtime",
          "domain",
          "application",
          "actions",
          "auth",
          "external",
          "presentation",
        ],
      },
      {
        "from": "http-routing",
        "allow": [],
      },
      {
        "from": "backend-composition",
        "allow": ["http-routing", "domain", "application", "external", "presentation"],
      },
      {
        "from": "runtime",
        "allow": [
          "http-routing",
          "backend-composition",
          "domain",
          "application",
          "actions",
          "auth",
          "external",
          "presentation",
        ],
      },
      {
        "from": "domain",
        "allow": [],
      },
      {
        "from": "application",
        "allow": ["domain"],
      },
      {
        "from": "actions",
        "allow": ["domain", "application"],
      },
      {
        "from": "auth",
        "allow": ["http-routing", "domain", "application"],
      },
      {
        "from": "external",
        "allow": ["domain", "application"],
      },
      {
        "from": "presentation",
        "allow": ["http-routing", "domain", "application", "actions"],
      },
      {
        "from": "tooling",
        "allow": ["ui", "ui-kit"],
      },
      {
        "from": "turbo-cache",
        "allow": [],
      },
    ],
    "coverage": {
      "requireAllFiles": true,
    },
  },
}
