{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "infra/alchemy/alchemy.run.ts",
    "infra/turbo-cache/aws.ts",
    "apps/ui/src/entry.ts",
    // The Website's Worker, deployed by path from the Alchemy stack.
    "apps/ui/src/worker.ts",
    "apps/ui/vite.config.ts",
    "apps/ui/vite.shared.ts",
    "apps/ui/vitest.config.ts",
    "packages/http-routing/src/index.ts",
    "packages/coffee/domain/test/**/*.ts",
    "packages/coffee/server/test/**/*.ts",
    "packages/coffee/presentation/actions/src/index.ts",
    "packages/coffee/presentation/actions/src/**/*.test.ts",
  ],
  "ignorePatterns": ["**/*.d.ts", "**/*.generated.ts", "**/dist/**"],
  // The Alchemy workspace builds the UI by path (`Cloudflare.Website.Vite`) rather than
  // importing it; the dependency exists so Turbo hashes UI changes into the smoke test.
  "ignoreDependencies": [
    // Runtime peers used by the Yielded WebAuthn server/browser adapters.
    "@simplewebauthn/server",
    "@simplewebauthn/browser",
    // Loaded by the Vite plugin chain in vite.config.ts, not imported from source.
    "@foldkit/vite-plugin",
    // happy-dom is the Vitest environment named in vitest.config.ts.
    "happy-dom",
    "oxlint-tsgolint",
    "@effect-coffee-shop/web",
  ],
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "off",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "warn",
    "coverage-gaps": "off",
    "feature-flags": "warn",
    "stale-suppressions": "warn",
    "unused-catalog-entries": "warn",
    "empty-catalog-groups": "warn",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "warn",
    "misconfigured-dependency-overrides": "error",
    // No rule packs are configured; state that the policy detector is intentionally unused.
    "policy-violation": "off",
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 3,
    "threshold": 14.5,
    "ignoreImports": true,
    "ignore": ["apps/ui/src/**/*.stories.tsx", "packages/ui-kit/src/**/*.stories.tsx"],
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 500,
    "maxUnitSize": 60,
  },
  "typeAware": {
    "enabled": true,
    "projects": [
      "packages/tooling/tsconfig.json",
      "apps/ui/tsconfig.app.json",
      "apps/ui/tsconfig.node.json",
      "packages/turbo-cache/tsconfig.json",
      "packages/http-routing/tsconfig.json",
      "packages/coffee/domain/tsconfig.json",
      "packages/coffee/application/tsconfig.json",
      "packages/ui-kit/tsconfig.json",
      "packages/coffee/auth/tsconfig.json",
      "packages/coffee/server/tsconfig.json",
      "packages/coffee/presentation/mcp/tsconfig.json",
      "packages/coffee/presentation/http/tsconfig.json",
      "packages/coffee/presentation/actions/tsconfig.json",
      "infra/alchemy/tsconfig.json",
      "infra/turbo-cache/tsconfig.json",
    ],
    "require": "complete",
  },
  "audit": {
    "gate": "new-only",
    "healthBaseline": ".fallow/health-baseline.json",
    "typeAware": false,
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": ["**/*.test.ts", "**/test-support.ts", "packages/coffee/*/test/**"],
      },
      {
        "name": "tooling",
        "patterns": [
          "packages/tooling/**",
          "**/oxlint.config.ts",
          "**/vitest.config.ts",
          "**/vitest.setup.ts",
          "apps/ui/vite*.ts",
        ],
      },
      {
        "name": "infra",
        "patterns": ["infra/**"],
      },
      {
        "name": "ui-kit",
        "patterns": ["packages/ui-kit/**"],
      },
      {
        "name": "ui",
        "patterns": ["apps/ui/**"],
      },
      {
        "name": "http-routing",
        "patterns": ["packages/http-routing/**"],
      },
      {
        "name": "domain",
        "patterns": ["packages/coffee/domain/**"],
      },
      {
        "name": "application",
        "patterns": ["packages/coffee/application/**"],
      },
      {
        "name": "actions",
        "patterns": ["packages/coffee/presentation/actions/**"],
      },
      {
        "name": "auth-contract",
        "patterns": ["packages/coffee/auth/src/contract.ts"],
      },
      {
        "name": "auth",
        "patterns": ["packages/coffee/auth/**"],
      },
      {
        "name": "presentation",
        "patterns": ["packages/coffee/presentation/**"],
      },
      {
        "name": "server",
        "patterns": ["packages/coffee/server/**"],
      },
      {
        "name": "turbo-cache",
        "patterns": ["packages/turbo-cache/**"],
      },
    ],
    "rules": [
      {
        "from": "infra",
        "allow": ["server", "ui", "turbo-cache"],
      },
      {
        "from": "ui-kit",
        "allow": [],
      },
      {
        "from": "ui",
        // The app is a client of the domain's Apis: it imports their declarations, ids and values.
        "allow": ["ui-kit", "auth-contract", "domain"],
      },
      {
        "from": "http-routing",
        "allow": [],
      },
      {
        "from": "domain",
        "allow": [],
      },
      {
        "from": "application",
        "allow": ["domain"],
      },
      {
        "from": "actions",
        "allow": ["domain", "application"],
      },
      {
        "from": "auth-contract",
        "allow": [],
      },
      {
        "from": "auth",
        "allow": ["auth-contract", "http-routing", "domain", "application"],
      },
      {
        "from": "presentation",
        "allow": ["http-routing", "domain", "application", "actions"],
      },
      {
        "from": "server",
        "allow": ["http-routing", "domain", "application", "actions", "auth", "presentation"],
      },
      {
        "from": "tooling",
        "allow": ["ui", "ui-kit"],
      },
      {
        "from": "turbo-cache",
        "allow": [],
      },
    ],
    "coverage": {
      "requireAllFiles": true,
    },
  },
}
