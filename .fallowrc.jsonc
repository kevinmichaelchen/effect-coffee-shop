{
  "$schema": "./node_modules/fallow/schema.json",

  "entry": [
    "alchemy.run.ts",
    "apps/backend/src/cloudflare/worker.ts",
    "apps/backend/src/cloudflare/mcp-miniflare-worker.ts",
    "apps/backend/src/bun/*.ts",
    "apps/backend/scripts/*.ts",
    "apps/backend/src/**/*.test.ts",
    "apps/backend/test/**/*.ts",
    "apps/ui/src/main.tsx",
    "apps/ui/src/**/*.stories.tsx",
    "apps/ui/.storybook/**/*.{ts,tsx}",
    "apps/ui/vite.config.ts",
    "apps/ui/vite.shared.ts",
    "apps/ui/vitest.config.ts",
    "packages/http-routing/src/index.ts",
    "packages/coffee/core/src/index.ts",
    "packages/coffee/core/src/**/*.test.ts",
    "packages/coffee/backend/src/index.ts",
    "packages/coffee/presentation/actions/src/index.ts",
    "packages/coffee/presentation/actions/src/**/*.test.ts",
    "packages/coffee/external/in-memory/src/index.ts",
    "packages/coffee/external/sqlite/src/index.ts",
    "packages/coffee/external/sqlite/src/bun/live.ts",
    "packages/coffee/external/sqlite/src/cloudflare/live.ts",
    "packages/coffee/runtime/aws/src/**/*.test.ts",
    "packages/coffee/runtime/cloudflare/src/**/*.test.ts"
  ],

  "ignorePatterns": [
    "**/*.d.ts",
    "**/*.generated.ts",
    "**/dist/**",
    "**/storybook-static/**",
    "packages/coffee/external/sqlite/src/sql/migrations/.generated/**",
    "packages/coffee/external/sqlite/src/sql/queries/.generated/**"
  ],

  "ignoreDependencies": [
    "@mpsuesser/oxlint-plugin-effect",
    "oxlint-tsgolint"
  ],

  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "off",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "warn",
    "coverage-gaps": "off",
    "feature-flags": "warn",
    "stale-suppressions": "warn",
    "unused-catalog-entries": "warn",
    "empty-catalog-groups": "warn",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "warn",
    "misconfigured-dependency-overrides": "error"
  },

  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 3,
    "threshold": 14.5,
    "ignoreImports": true,
    "ignore": [
      "apps/ui/src/**/*.stories.tsx",
      "packages/coffee/external/drizzle-postgres/src/db/auth-schema.ts",
      "packages/coffee/external/drizzle-postgres/src/db/schema.ts"
    ]
  },

  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 500,
    "maxUnitSize": 60
  },

  "typeAware": {
    "enabled": true,
    "projects": ["packages/coffee/core/tsconfig.json"],
    "require": "best-effort"
  },

  "audit": {
    "gate": "new-only",
    "healthBaseline": ".fallow/health-baseline.json",
    "typeAware": false
  },

  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "**/*.test.ts",
          "**/test-support.ts",
          "apps/backend/scripts/**",
          "apps/backend/test/**"
        ]
      },
      {
        "name": "infra",
        "patterns": ["alchemy.run.ts"]
      },
      {
        "name": "ui",
        "patterns": ["apps/ui/**"]
      },
      {
        "name": "backend-app",
        "patterns": ["apps/backend/**"]
      },
      {
        "name": "http-routing",
        "patterns": ["packages/http-routing/**"]
      },
      {
        "name": "backend-composition",
        "patterns": ["packages/coffee/backend/**"]
      },
      {
        "name": "runtime",
        "patterns": ["packages/coffee/runtime/**"]
      },
      {
        "name": "domain",
        "patterns": ["packages/coffee/core/src/domain/**"]
      },
      {
        "name": "application",
        "patterns": ["packages/coffee/core/src/application/**", "packages/coffee/core/src/index.ts"]
      },
      {
        "name": "actions",
        "patterns": ["packages/coffee/presentation/actions/**"]
      },
      {
        "name": "assistant",
        "patterns": ["packages/coffee/assistant/**"]
      },
      {
        "name": "auth",
        "patterns": ["packages/coffee/auth/**"]
      },
      {
        "name": "external",
        "patterns": ["packages/coffee/external/**"]
      },
      {
        "name": "presentation",
        "patterns": ["packages/coffee/presentation/**"]
      }
    ],
    "rules": [
      {
        "from": "infra",
        "allow": ["backend-app", "ui", "external", "runtime"]
      },
      {
        "from": "ui",
        "allow": []
      },
      {
        "from": "backend-app",
        "allow": [
          "http-routing",
          "backend-composition",
          "runtime",
          "domain",
          "application",
          "actions",
          "assistant",
          "auth",
          "external",
          "presentation"
        ]
      },
      {
        "from": "http-routing",
        "allow": []
      },
      {
        "from": "backend-composition",
        "allow": ["http-routing", "domain", "application", "external", "presentation"]
      },
      {
        "from": "runtime",
        "allow": [
          "http-routing",
          "backend-composition",
          "domain",
          "application",
          "actions",
          "assistant",
          "auth",
          "external",
          "presentation"
        ]
      },
      {
        "from": "domain",
        "allow": []
      },
      {
        "from": "application",
        "allow": ["domain"]
      },
      {
        "from": "actions",
        "allow": ["domain", "application"]
      },
      {
        "from": "assistant",
        "allow": ["http-routing", "domain", "application", "actions"]
      },
      {
        "from": "auth",
        "allow": ["http-routing", "domain", "application", "actions"]
      },
      {
        "from": "external",
        "allow": ["domain", "application"]
      },
      {
        "from": "presentation",
        "allow": ["http-routing", "domain", "application", "actions"]
      }
    ]
  }
}
