{
  "name": "@effect-coffee-shop/coffee-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsrs oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsrs oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/domain/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@yielded/sync": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@typeonce/effect-machine": "0.46.0",
    "@types/bun": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
