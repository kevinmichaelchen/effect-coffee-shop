{
  "name": "@effect-coffee-shop/coffee-domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cart": "./src/cart.ts",
    "./checkout-session": "./src/checkout-session.ts",
    "./errors": "./src/errors.ts",
    "./menu": "./src/menu.ts",
    "./money": "./src/money.ts",
    "./order-primitives": "./src/order-primitives.ts",
    "./order": "./src/order.ts",
    "./typed-id": "./src/typed-id.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/domain/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@just-be/effect-typed-id": "0.5.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
