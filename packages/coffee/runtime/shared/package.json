{
  "name": "@effect-coffee-shop/coffee-runtime-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/env.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c ../../../oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../../oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "cd ../../../../apps/backend && lintcn lint --tsconfig ../../packages/coffee/runtime/shared/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
