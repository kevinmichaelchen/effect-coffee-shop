{
  "name": "@effect-coffee-shop/coffee-runtime-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/worker.ts",
    "./env": "./src/env.ts",
    "./router": "./src/router.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "bun --bun oxlint -c ../../../.oxlintrc.json --disable-nested-config .",
    "lint:fix": "bun --bun oxlint -c ../../../.oxlintrc.json --disable-nested-config --fix .",
    "lint:custom": "cd ../../../../apps/backend && lintcn lint --tsconfig ../../packages/coffee/runtime/cloudflare/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-assistant": "workspace:*",
    "@effect-coffee-shop/coffee-auth": "workspace:*",
    "@effect-coffee-shop/coffee-backend": "workspace:*",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "@effect-coffee-shop/coffee-external-sqlite": "workspace:*",
    "@effect-coffee-shop/coffee-http": "workspace:*",
    "@effect-coffee-shop/coffee-mcp": "workspace:*",
    "@effect-coffee-shop/coffee-runtime-shared": "workspace:*",
    "@effect-coffee-shop/http-routing": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
