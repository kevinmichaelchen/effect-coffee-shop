{
  "name": "@effect-coffee-shop/coffee-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/server/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-auth": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "@effect-coffee-shop/coffee-http": "workspace:*",
    "@effect-coffee-shop/coffee-mcp": "workspace:*",
    "@effect-coffee-shop/http-routing": "workspace:*",
    "@yielded/auth-persistence": "catalog:",
    "@yielded/sync": "catalog:",
    "@yielded/sync-platform-alchemy-cf": "catalog:",
    "@yielded/sync-platform-cloudflare": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "effect-wide-event": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
