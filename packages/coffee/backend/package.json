{
  "name": "@effect-coffee-shop/coffee-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-layer": "./src/app-layer.ts",
    "./http/backend": "./src/http/backend.ts",
    "./http/direct-auth": "./src/http/direct-auth.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/backend/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-auth": "workspace:*",
    "@effect-coffee-shop/coffee-external-sqlite": "workspace:*",
    "@effect-coffee-shop/coffee-http": "workspace:*",
    "@effect-coffee-shop/coffee-mcp": "workspace:*",
    "@effect-coffee-shop/http-routing": "workspace:*",
    "@yielded/auth-persistence": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-coffee-shop/coffee-external-drizzle-postgres": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/bun": "catalog:",
    "@yielded/auth": "catalog:",
    "miniflare": "4.20260730.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
