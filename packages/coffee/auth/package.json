{
  "name": "@effect-coffee-shop/coffee-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./server": "./src/server.ts",
    "./database": "./src/database.ts",
    "./yielded/identity": "./src/yielded/identity.ts",
    "./oauth": "./src/oauth.ts",
    "./config": "./src/config.ts",
    "./testing/auth-client": "./src/testing/auth-client.ts",
    "./testing/passkey": "./src/testing/passkey.ts",
    "./adapters": "./src/adapters.ts",
    "./testing/migrate": "./src/testing/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit && effect-tsrs diagnostics --project tsconfig.json",
    "lint": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/auth/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "@effect/sql-d1": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@yielded/auth": "catalog:",
    "@yielded/auth-persistence": "catalog:",
    "@yielded/auth-simplewebauthn": "catalog:",
    "@yielded/crypto": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@levischuck/tiny-cbor": "0.2.11",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/bun": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "miniflare": "4.20260730.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
