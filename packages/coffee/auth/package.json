{
  "name": "@effect-coffee-shop/coffee-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./better-auth/cloudflare": "./src/better-auth/cloudflare.ts",
    "./better-auth/shared": "./src/better-auth/shared.ts",
    "./better-auth/users": "./src/better-auth/users.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/auth/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/http-routing": "workspace:*",
    "better-auth": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "catalog:",
    "@effect-coffee-shop/coffee-external-sqlite": "workspace:*",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
