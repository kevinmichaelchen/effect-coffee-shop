{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "@effect-coffee-shop/coffee-assistant",
          "@effect-coffee-shop/coffee-assistant/*",
          "@effect-coffee-shop/coffee-cli",
          "@effect-coffee-shop/coffee-cli/*",
          "@effect-coffee-shop/coffee-http",
          "@effect-coffee-shop/coffee-http/*",
          "@effect-coffee-shop/coffee-mcp",
          "@effect-coffee-shop/coffee-mcp/*"
        ]
      }
    ]
  }
}
