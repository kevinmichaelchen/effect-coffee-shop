{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node", "vitest"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "@effect-coffee-shop/coffee-cli",
          "@effect-coffee-shop/coffee-cli/*",
          "@effect-coffee-shop/coffee-http",
          "@effect-coffee-shop/coffee-http/*",
          "@effect-coffee-shop/coffee-mcp",
          "@effect-coffee-shop/coffee-mcp/*"
        ]
      }
    ],
    "vitest/no-focused-tests": "error",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "it.scopedLive"]
      }
    ],
    "vitest/expect-expect": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/testing/**/*.ts", "**/test-support.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "only",
            "message": "Focused tests must not be committed, including Effect test wrappers."
          }
        ]
      }
    }
  ]
}
