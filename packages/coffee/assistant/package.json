{
  "name": "@effect-coffee-shop/coffee-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./handler": "./src/handler.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --disable-nested-config .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --disable-nested-config --fix .",
    "lint:custom": "cd ../../../apps/backend && lintcn lint --tsconfig ../../packages/coffee/assistant/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/backend-host": "workspace:*",
    "@effect-coffee-shop/coffee-actions": "workspace:*",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "@tanstack/ai": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-coffee-shop/coffee-external-in-memory": "workspace:*",
    "@types/bun": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
