{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "@effect-coffee-shop/backend",
          "@effect-coffee-shop/backend/*",
          "@effect-coffee-shop/coffee-cli",
          "@effect-coffee-shop/coffee-cli/*",
          "@effect-coffee-shop/coffee-http",
          "@effect-coffee-shop/coffee-http/*",
          "@effect-coffee-shop/coffee-mcp",
          "@effect-coffee-shop/coffee-mcp/*",
          "bun:*",
          "node:*"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@cloudflare/*",
              "@effect-coffee-shop/http-routing",
              "@effect-coffee-shop/http-routing/*",
              "@effect-coffee-shop/coffee-actions",
              "@effect-coffee-shop/coffee-actions/*",
              "@tanstack/*",
              "../external/*",
              "../external/**",
              "../presentation/*",
              "../presentation/**",
              "../../external/*",
              "../../external/**",
              "../../presentation/*",
              "../../presentation/**",
              "effect/unstable/http",
              "effect/unstable/http/*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/tools/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@cloudflare/*",
              "@effect-coffee-shop/http-routing",
              "@effect-coffee-shop/http-routing/*",
              "@tanstack/*",
              "../external/*",
              "../external/**",
              "../presentation/*",
              "../presentation/**",
              "effect/unstable/http",
              "effect/unstable/http/*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/external/providers/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@effect-coffee-shop/http-routing",
              "@effect-coffee-shop/http-routing/*",
              "@effect-coffee-shop/coffee-actions",
              "@effect-coffee-shop/coffee-actions/*",
              "@effect-coffee-shop/coffee-core",
              "@effect-coffee-shop/coffee-core/*",
              "@tanstack/*",
              "../presentation/*",
              "../presentation/**",
              "../../presentation/*",
              "../../presentation/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/presentation/http/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../external/*", "../external/**", "../../external/*", "../../external/**"]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
