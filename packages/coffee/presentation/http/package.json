{
  "name": "@effect-coffee-shop/coffee-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit && effect-tsrs diagnostics --project tsconfig.json",
    "lint": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../../tooling lint:custom:run --tsconfig ../coffee/presentation/http/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
