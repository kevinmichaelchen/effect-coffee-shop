{
  "name": "@effect-coffee-shop/coffee-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./domain-rest": "./src/domain-rest.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --fix .",
    "lint:custom": "bun run --cwd ../../../tooling lint:custom:run --tsconfig ../coffee/presentation/http/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
