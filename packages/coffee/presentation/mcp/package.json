{
  "name": "@effect-coffee-shop/coffee-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./action-toolkit": "./src/action-toolkit.ts",
    "./action-tools": "./src/action-tools.ts",
    "./prompts": "./src/prompts.ts",
    "./resources": "./src/resources.ts",
    "./server": "./src/server.ts",
    "./actor": "./src/actor.ts",
    "./domain-tools": "./src/domain-tools.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsgo oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsgo oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --fix .",
    "lint:custom": "bun run --cwd ../../../tooling lint:custom:run --tsconfig ../coffee/presentation/mcp/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect-coffee-shop/coffee-actions": "workspace:*",
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
