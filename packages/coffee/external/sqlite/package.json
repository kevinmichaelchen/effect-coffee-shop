{
  "name": "@effect-coffee-shop/coffee-external-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/bun/live.ts",
    "./cloudflare": "./src/cloudflare/live.ts",
    "./sql/*": "./src/sql/*.ts"
  },
  "scripts": {
    "auth:schema": "cd src/sql && bunx @better-auth/cli generate --config better-auth-schema.ts --yes",
    "db:check": "sqlfu --config src/sql/sqlfu.config.ts check",
    "db:draft": "sqlfu --config src/sql/sqlfu.config.ts draft",
    "db:format": "sqlfu --config src/sql/sqlfu.config.ts format \"src/sql/**/*.sql\"",
    "db:generate": "sqlfu --config src/sql/sqlfu.config.ts generate && oxfmt --write \"src/sql/**/*.ts\"",
    "db:migrate": "sqlfu --config src/sql/sqlfu.config.ts migrate",
    "typecheck": "tsgo --noEmit",
    "lint": "bun --bun oxlint -c ../../../.oxlintrc.json --disable-nested-config .",
    "lint:fix": "bun --bun oxlint -c ../../../.oxlintrc.json --disable-nested-config --fix .",
    "lint:custom": "cd ../../../../apps/backend && lintcn lint --tsconfig ../../packages/coffee/external/sqlite/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/agent-auth": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "sqlfu": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
