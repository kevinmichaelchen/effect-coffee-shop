{
  "name": "@effect-coffee-shop/coffee-external-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/bun/live.ts",
    "./cloudflare": "./src/cloudflare/live.ts",
    "./sql/CartItemIdGenerator": "./src/sql/CartItemIdGenerator.ts",
    "./sql/CheckoutSessionIdGenerator": "./src/sql/CheckoutSessionIdGenerator.ts",
    "./sql/OrderIdGenerator": "./src/sql/OrderIdGenerator.ts",
    "./sql/SqlCartRepository": "./src/sql/SqlCartRepository.ts",
    "./sql/SqlCheckoutSessionRepository": "./src/sql/SqlCheckoutSessionRepository.ts",
    "./sql/SqlMenuRepository": "./src/sql/SqlMenuRepository.ts",
    "./sql/SqlOrderRepository": "./src/sql/SqlOrderRepository.ts",
    "./sql/live": "./src/sql/live.ts",
    "./sql/models": "./src/sql/models.ts",
    "./sql/persistence": "./src/sql/persistence.ts",
    "./sql/schema-ready": "./src/sql/schema-ready.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../../tooling lint:custom:run --tsconfig ../coffee/external/sqlite/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-testing": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
