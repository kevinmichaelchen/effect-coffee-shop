{
  "name": "@effect-coffee-shop/coffee-external-drizzle-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db/*": "./src/db/*.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../../tooling lint:custom:run --tsconfig ../coffee/external/drizzle-postgres/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-coffee-shop/coffee-testing": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pglite-test": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
