{
  "name": "@effect-coffee-shop/coffee-external-in-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./in-memory/*": "./src/in-memory/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c ../../../tooling/oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../../tooling lint:custom:run --tsconfig ../coffee/external/in-memory/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-application": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-coffee-shop/coffee-testing": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
