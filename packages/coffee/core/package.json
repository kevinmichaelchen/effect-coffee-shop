{
  "name": "@effect-coffee-shop/coffee-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#domain/*": "./src/domain/*.ts",
    "#application/*": "./src/application/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./domain/cart": "./src/domain/cart.ts",
    "./domain/checkout-session": "./src/domain/checkout-session.ts",
    "./domain/errors": "./src/domain/errors.ts",
    "./domain/menu": "./src/domain/menu.ts",
    "./domain/money": "./src/domain/money.ts",
    "./domain/order-primitives": "./src/domain/order-primitives.ts",
    "./domain/order": "./src/domain/order.ts",
    "./domain/typed-id": "./src/domain/typed-id.ts",
    "./application/CoffeeOrderApp": "./src/application/CoffeeOrderApp.ts",
    "./application/CurrentActor": "./src/application/CurrentActor.ts",
    "./application/contracts": "./src/application/contracts.ts",
    "./application/errors": "./src/application/errors.ts",
    "./application/observability": "./src/application/observability.ts",
    "./application/ports/*": "./src/application/ports/*.ts",
    "./application/use-cases/*": "./src/application/use-cases/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error .",
    "lint:fix": "bun --bun oxlint -c oxlint.config.ts --disable-nested-config --report-unused-disable-directives-severity error --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/core/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@just-be/effect-typed-id": "0.5.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
