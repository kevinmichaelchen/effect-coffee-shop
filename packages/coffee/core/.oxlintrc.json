{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "#application/*",
              "../application/*",
              "../../application/*",
              "../../../application/*",
              "@effect-coffee-shop/backend",
              "@effect-coffee-shop/backend/*",
              "@effect-coffee-shop/backend-host",
              "@effect-coffee-shop/backend-host/*",
              "@effect-coffee-shop/coffee-actions",
              "@effect-coffee-shop/coffee-actions/*",
              "@effect-coffee-shop/coffee-assistant",
              "@effect-coffee-shop/coffee-assistant/*",
              "@effect-coffee-shop/coffee-auth",
              "@effect-coffee-shop/coffee-auth/*",
              "@effect-coffee-shop/coffee-core/application/*",
              "@effect-coffee-shop/coffee-external-*",
              "@effect-coffee-shop/coffee-external-*/*",
              "@effect-coffee-shop/coffee-http",
              "@effect-coffee-shop/coffee-http/*",
              "@effect-coffee-shop/coffee-mcp",
              "@effect-coffee-shop/coffee-mcp/*",
              "@effect/platform-bun",
              "@effect/platform-bun/*",
              "@effect/platform-node",
              "@effect/platform-node/*",
              "@effect/sql-*",
              "@effect/sql-*/*",
              "better-auth",
              "better-auth/*",
              "bun:*",
              "node:*"
            ]
          }
        ]
      }
    }
  ]
}
