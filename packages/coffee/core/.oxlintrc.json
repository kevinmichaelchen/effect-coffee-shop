{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node", "vitest"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live", "it.scoped", "it.scopedLive"]
      }
    ],
    "vitest/expect-expect": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@effect-coffee-shop/backend",
              "@effect-coffee-shop/backend/*",
              "@effect-coffee-shop/http-routing",
              "@effect-coffee-shop/http-routing/*",
              "@effect-coffee-shop/coffee-actions",
              "@effect-coffee-shop/coffee-actions/*",
              "@effect-coffee-shop/coffee-auth",
              "@effect-coffee-shop/coffee-auth/*",
              "@effect-coffee-shop/coffee-cli",
              "@effect-coffee-shop/coffee-cli/*",
              "@effect-coffee-shop/coffee-external-*",
              "@effect-coffee-shop/coffee-external-*/*",
              "@effect-coffee-shop/coffee-http",
              "@effect-coffee-shop/coffee-http/*",
              "@effect-coffee-shop/coffee-mcp",
              "@effect-coffee-shop/coffee-mcp/*",
              "@tanstack/*",
              "better-auth",
              "better-auth/*",
              "bun:*",
              "node:*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "#application/*",
              "../application/*",
              "../../application/*",
              "../../../application/*",
              "@effect-coffee-shop/backend",
              "@effect-coffee-shop/backend/*",
              "@effect-coffee-shop/http-routing",
              "@effect-coffee-shop/http-routing/*",
              "@effect-coffee-shop/coffee-actions",
              "@effect-coffee-shop/coffee-actions/*",
              "@effect-coffee-shop/coffee-auth",
              "@effect-coffee-shop/coffee-auth/*",
              "@effect-coffee-shop/coffee-core/application/*",
              "@effect-coffee-shop/coffee-external-*",
              "@effect-coffee-shop/coffee-external-*/*",
              "@effect-coffee-shop/coffee-http",
              "@effect-coffee-shop/coffee-http/*",
              "@effect-coffee-shop/coffee-mcp",
              "@effect-coffee-shop/coffee-mcp/*",
              "@effect/platform-bun",
              "@effect/platform-bun/*",
              "@effect/platform-node",
              "@effect/platform-node/*",
              "@effect/sql-*",
              "@effect/sql-*/*",
              "better-auth",
              "better-auth/*",
              "bun:*",
              "node:*"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/testing/**/*.ts", "**/test-support.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "only",
            "message": "Focused tests must not be committed, including Effect test wrappers."
          }
        ]
      }
    },
    {
      "files": ["src/application/testing/repository-contract.ts"],
      "rules": {
        "vitest/valid-title": "off",
        "vitest/expect-expect": "off"
      }
    }
  ]
}
