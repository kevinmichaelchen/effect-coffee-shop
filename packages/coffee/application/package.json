{
  "name": "@effect-coffee-shop/coffee-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ActorHeader": "./src/ActorHeader.ts",
    "./CoffeeOrderApp": "./src/CoffeeOrderApp.ts",
    "./CurrentActor": "./src/CurrentActor.ts",
    "./contracts": "./src/contracts.ts",
    "./errors": "./src/errors.ts",
    "./observability": "./src/observability.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint -c ../../tooling/oxlint.config.ts --disable-nested-config --fix .",
    "lint:custom": "bun run --cwd ../../tooling lint:custom:run --tsconfig ../coffee/application/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
