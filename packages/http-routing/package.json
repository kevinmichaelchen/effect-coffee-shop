{
  "name": "@effect-coffee-shop/http-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts",
    "./logging": "./src/logging.ts",
    "./route": "./src/route.ts",
    "./observability": "./src/observability.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsrs oxlint -c ../tooling/oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsrs oxlint -c ../tooling/oxlint.config.ts --disable-nested-config --fix .",
    "lint:custom": "bun run --cwd ../tooling lint:custom:run --tsconfig ../http-routing/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "catalog:",
    "effect-wide-event": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
