{
  "name": "@effect-coffee-shop/tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsgo --tsrs-lint oxlint -c oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint -c oxlint.config.ts --disable-nested-config --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
