{
  "name": "@effect-coffee-shop/tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsrs oxlint -c oxlint.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsrs oxlint -c oxlint.config.ts --disable-nested-config --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "lint:custom:run": "lintcn lint",
    "lint:custom:build": "lintcn build",
    "lint:custom:list": "lintcn list"
  },
  "devDependencies": {
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
