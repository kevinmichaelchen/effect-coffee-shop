{
  "$schema": "../../../node_modules/fallow/rule-pack-schema.json",
  "version": 1,
  "name": "runtime-boundaries",
  "description": "Keep runtime-specific imports and direct side effects out of the portable core. Zones and allowed imports between workspaces live in .fallowrc.jsonc.",
  "rules": [
    {
      "id": "core-no-runtime-imports",
      "kind": "banned-import",
      "zones": ["domain", "application", "actions"],
      "specifiers": [
        "node:assert",
        "node:async_hooks",
        "node:buffer",
        "node:child_process",
        "node:cluster",
        "node:console",
        "node:crypto",
        "node:dgram",
        "node:diagnostics_channel",
        "node:dns",
        "node:events",
        "node:fs",
        "node:http",
        "node:http2",
        "node:https",
        "node:inspector",
        "node:module",
        "node:net",
        "node:os",
        "node:path",
        "node:perf_hooks",
        "node:process",
        "node:readline",
        "node:sqlite",
        "node:stream",
        "node:string_decoder",
        "node:test",
        "node:timers",
        "node:tls",
        "node:tty",
        "node:url",
        "node:util",
        "node:v8",
        "node:vm",
        "node:worker_threads",
        "node:zlib",
        "bun",
        "bun:sqlite",
        "bun:ffi",
        "bun:jsc",
        "bun:test",
      ],
      "message": "Core code is runtime-agnostic. Use Effect services (FileSystem, Path, Crypto, HttpClient) and provide the platform at the server or infra boundary.",
    },
    {
      "id": "domain-no-platform-adapters",
      "kind": "banned-import",
      "zones": ["domain"],
      "specifiers": [
        "@effect/platform-bun",
        "@effect/platform-node",
        "@effect/platform-browser",
        "@effect/sql-d1",
        "@effect/sql-sqlite-do",
      ],
      "message": "The domain declares services; platform and SQL adapters are provided by the server or infra.",
    },
    {
      "id": "actions-no-host-or-ai-imports",
      "kind": "banned-import",
      "zones": ["actions"],
      "specifiers": ["@cloudflare/workers-types", "effect/ai", "effect/unstable/ai"],
      "message": "Actions are transport-neutral. Cloudflare bindings and AI toolkits belong to the presentation adapters.",
    },
    {
      "id": "core-no-direct-effects",
      "kind": "banned-effect",
      "zones": ["domain", "application", "actions"],
      "effects": ["network", "storage", "process", "shell"],
      "message": "Core code performs I/O through Effect services so it stays testable and portable. Use HttpClient or FileSystem instead of fetch and node APIs.",
    },
  ],
}
