{
  "name": "@effect-coffee-shop/coffee-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./command": "./src/command.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json --disable-nested-config .",
    "lint:fix": "oxlint -c ../.oxlintrc.json --disable-nested-config --fix .",
    "lint:custom": "cd ../../apps/backend && lintcn lint --tsconfig ../../packages/coffee-cli/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/backend-host": "workspace:*",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
