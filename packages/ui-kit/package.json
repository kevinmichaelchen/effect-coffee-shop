{
  "name": "@effect-coffee-shop/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    "./components/*": "./src/components/*.ts",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint": "effect-tsrs oxlint -c ../tooling/oxlint.ui.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsrs oxlint -c ../tooling/oxlint.ui.config.ts --disable-nested-config --fix .",
    "lint:custom": "bun run --cwd ../../apps/ui lint:custom:run --tsconfig ../../packages/ui-kit/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@foldkit/ui": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@yielded/effect-tsrs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
