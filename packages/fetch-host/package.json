{
  "name": "@effect-coffee-shop/fetch-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fetch-host": "./src/fetch-host.ts",
    "./json": "./src/json.ts",
    "./logging": "./src/logging.ts",
    "./route": "./src/route.ts",
    "./observability": "./src/observability.ts",
    "./request-services": "./src/request-services.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "bun --bun oxlint -c ../.oxlintrc.json --disable-nested-config .",
    "lint:fix": "bun --bun oxlint -c ../.oxlintrc.json --disable-nested-config --fix .",
    "lint:custom": "cd ../../apps/backend && lintcn lint --tsconfig ../../packages/fetch-host/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
