{
  "name": "effect-coffee-shop",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/http-routing",
      "packages/ui-kit",
      "packages/coffee/domain",
      "packages/coffee/application",
      "packages/coffee/auth",
      "packages/coffee/server",
      "packages/coffee/presentation/*",
      "packages/turbo-cache",
      "infra/*",
      "packages/tooling"
    ],
    "catalog": {
      "@alchemy.run/aws": "2.0.0-beta.84",
      "@alchemy.run/cloudflare": "2.0.0-beta.84",
      "@alchemy.run/domain": "2.0.0-beta.84",
      "@cloudflare/workers-types": "5.20260930.1",
      "@effect/platform-browser": "4.1.0",
      "@effect/platform-bun": "4.1.0",
      "@effect/platform-node": "4.1.0",
      "@effect/sql-d1": "4.1.0",
      "@effect/vitest": "4.1.0",
      "@foldkit/ui": "0.169.0",
      "@foldkit/vite-plugin": "0.28.0",
      "@huggingface/tokenizers": "0.2.0",
      "@huggingface/transformers": "4.3.2",
      "@huggingface/transformers-structured-output": "4.3.2",
      "@mpsuesser/oxlint-plugin-effect": "0.6.0",
      "@simplewebauthn/browser": "14.0.0",
      "@simplewebauthn/server": "14.0.3",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.3",
      "@yielded/auth": "0.1.0-beta.46",
      "@yielded/auth-persistence": "0.1.0-beta.46",
      "@yielded/auth-simplewebauthn": "0.1.0-beta.46",
      "@yielded/crypto": "0.1.0-beta.46",
      "@yielded/effect-tsrs": "0.2.2",
      "@yielded/sync": "0.1.0-beta.4",
      "@yielded/sync-platform-alchemy-cf": "0.1.0-beta.4",
      "@yielded/sync-platform-cloudflare": "0.1.0-beta.4",
      "alchemy": "2.0.0-beta.84",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "effect": "4.1.0",
      "effect-wide-event": "0.6.0",
      "fallow": "3.30.0",
      "foldkit": "0.169.0",
      "happy-dom": "^20.14.5",
      "lintcn": "^0.10.1",
      "onnxruntime-node": "1.30.0",
      "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
      "oxfmt": "0.75.0",
      "oxlint": "1.90.0",
      "oxlint-tsgolint": "7.0.2005",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "tsrs": "0.20.1-ts7.1.0-beta",
      "vite": "^8.3.1",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1 && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:profile": "alchemy profile",
    "cf:profile:edit": "alchemy profile edit --add Cloudflare",
    "cf:plan": "alchemy plan ./infra/alchemy/cloudflare.ts",
    "cf:dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:deploy": "alchemy deploy ./infra/alchemy/cloudflare.ts",
    "cf:destroy": "alchemy destroy ./infra/alchemy/cloudflare.ts",
    "cf:test": "turbo run test --filter=@effect-coffee-shop/infra-alchemy",
    "cf:state:tree": "alchemy state list --recursive --config ./infra/alchemy/cloudflare.ts",
    "cf:state:list": "alchemy state list --config ./infra/alchemy/cloudflare.ts",
    "infra:plan": "alchemy plan ./infra/alchemy/alchemy.run.ts",
    "infra:dev": "alchemy dev ./infra/alchemy/alchemy.run.ts",
    "infra:deploy": "alchemy deploy ./infra/alchemy/alchemy.run.ts",
    "infra:destroy": "alchemy destroy ./infra/alchemy/alchemy.run.ts",
    "infra:state:tree": "alchemy state list --recursive --config ./infra/alchemy/alchemy.run.ts",
    "infra:state:list": "alchemy state list --config ./infra/alchemy/alchemy.run.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:custom": "turbo run lint:custom",
    "lint:custom:build": "bun run --cwd packages/tooling lint:custom:build",
    "lint:custom:list": "bun run --cwd packages/tooling lint:custom:list",
    "fmt": "turbo run fmt && bun run fmt:root",
    "fmt:check": "turbo run fmt:check //#fmt:check:root",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run lint:custom && bun run test && bun run build && bun run fallow && bun run knip && bun run knip:production",
    "check:affected": "turbo run typecheck lint fmt:check test build --affected && turbo run lint:custom //#fmt:check:root && bun run fallow && bun run knip && bun run knip:production",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "lint:custom:affected": "bun run lint:custom",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "hooks:install": "prek install --overwrite --prepare-hooks",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push",
    "fallow": "fallow --summary --skip health && fallow health --summary --no-type-aware",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --no-type-aware",
    "fallow:audit": "fallow audit --changed-since origin/main",
    "fallow:ci": "fallow --ci --skip health && fallow health --ci --no-type-aware",
    "fallow:health:baseline": "fallow health --no-type-aware --save-baseline .fallow/health-baseline.json --baseline-mode identity",
    "ci:static": "turbo run typecheck lint fmt:check",
    "ci:backend": "turbo run test --concurrency=2 --filter=!@effect-coffee-shop/web",
    "ci:ui": "turbo run test build --filter=@effect-coffee-shop/web",
    "cache:dev": "alchemy dev ./infra/turbo-cache/cloudflare.ts",
    "cache:deploy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:deploy:aws": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:test": "turbo run test --filter=@effect-coffee-shop/infra-turbo-cache",
    "cache:env": "varlock load --path infra/turbo-cache/",
    "cache:destroy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:destroy:aws": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:run": "varlock run --path config/turbo-cache/ --",
    "knip": "knip --cache --treat-config-hints-as-errors --include nsExports,nsTypes --cycles",
    "fmt:root": "oxfmt --write package.json knip.jsonc .fallowrc.jsonc turbo.json",
    "fmt:check:root": "oxfmt --check package.json knip.jsonc .fallowrc.jsonc turbo.json",
    "knip:production": "knip --cache --strict --treat-config-hints-as-errors --include nsExports,nsTypes --cycles",
    "patches:check": "bun patches/check.ts"
  },
  "devDependencies": {
    "@alchemy.run/aws": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-d1": "4.1.0",
    "@j178/prek": "0.5.5",
    "@yielded/effect-tsrs": "catalog:",
    "alchemy": "catalog:",
    "fallow": "catalog:",
    "knip": "6.40.0",
    "oxfmt": "catalog:",
    "tsrs": "catalog:",
    "turbo": "2.11.7",
    "varlock": "1.21.1"
  },
  "overrides": {
    "@effect/platform-browser": "4.1.0",
    "@effect/sql-d1": "4.1.0",
    "@effect/sql-sqlite-do": "4.1.0",
    "@effect/vitest": "4.1.0",
    "effect": "4.1.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@alchemy.run/domain@2.0.0-beta.84": "patches/@alchemy.run%2Fdomain@2.0.0-beta.84.patch",
    "alchemy@2.0.0-beta.84": "patches/alchemy@2.0.0-beta.84.patch",
    "@yielded/auth-persistence@0.1.0-beta.46": "patches/@yielded%2Fauth-persistence@0.1.0-beta.46.patch",
    "effect@4.1.0": "patches/effect@4.1.0.patch"
  }
}
