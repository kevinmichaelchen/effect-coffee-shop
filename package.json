{
  "name": "effect-v4-onion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend"],
  "scripts": {
    "http": "bun run --cwd backend http",
    "cli": "bun run --cwd backend cli",
    "mcp:stdio": "bun run --cwd backend mcp:stdio",
    "mcp:http": "bun run --cwd backend mcp:http",
    "dev:onion:api": "PORTLESS_STATE_DIR=/tmp/effect-v4-onion-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless api.onion bash scripts/dev-onion-api.sh",
    "typecheck": "bun run --cwd backend typecheck",
    "lint": "bun run --cwd backend lint",
    "lint:fix": "bun run --cwd backend lint:fix",
    "lint:custom": "bun run --cwd backend lint:custom",
    "lint:custom:build": "bun run --cwd backend lint:custom:build",
    "lint:custom:list": "bun run --cwd backend lint:custom:list",
    "fmt": "bun run --cwd backend fmt",
    "fmt:check": "bun run --cwd backend fmt:check",
    "knip": "bun run --cwd backend knip",
    "check": "bun run typecheck && bun run lint && bun run lint:custom && bun run fmt:check && bun run test",
    "test": "bun run --cwd backend test",
    "hooks:install": "prek install --overwrite",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push"
  },
  "devDependencies": {
    "@j178/prek": "0.3.8"
  },
  "packageManager": "bun@1.3.11"
}
