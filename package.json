{
  "name": "effect-coffee-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/http-routing",
      "packages/coffee/core",
      "packages/coffee/assistant",
      "packages/coffee/auth",
      "packages/coffee/backend",
      "packages/coffee/external/*",
      "packages/coffee/presentation/*",
      "packages/coffee/runtime/*"
    ],
    "catalog": {
      "@better-auth/agent-auth": "0.6.2",
      "@better-auth/drizzle-adapter": "1.6.26",
      "@better-auth/passkey": "^1.6.26",
      "@cloudflare/workers-types": "^5.20260804.1",
      "@effect/platform-bun": "4.0.0-rc.111",
      "@effect/platform-node": "4.0.0-rc.111",
      "@effect/sql-d1": "4.0.0-rc.111",
      "@effect/sql-pg": "4.0.0-rc.111",
      "@effect/sql-pglite": "4.0.0-rc.111",
      "@effect/sql-sqlite-bun": "4.0.0-rc.111",
      "@effect/vitest": "4.0.0-rc.111",
      "@electric-sql/pglite": "^0.5.4",
      "@eslint/js": "^10.0.1",
      "@radix-ui/react-dialog": "^1.1.23",
      "@radix-ui/react-label": "^2.1.15",
      "@radix-ui/react-progress": "^1.1.16",
      "@radix-ui/react-select": "^2.3.7",
      "@radix-ui/react-slot": "^1.3.3",
      "@storybook/addon-a11y": "^10.5.7",
      "@storybook/addon-docs": "^10.5.7",
      "@storybook/addon-vitest": "^10.5.7",
      "@storybook/react-vite": "^10.5.7",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/ai": "0.43.1",
      "@tanstack/ai-client": "0.23.1",
      "@tanstack/ai-react": "0.19.1",
      "@tanstack/react-query": "^5.101.4",
      "@types/bun": "^1.3.14",
      "@types/node": "^26.1.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "@vitest/browser": "^4.1.10",
      "@vitest/browser-playwright": "^4.1.10",
      "alchemy": "2.0.0-beta.72",
      "better-auth": "^1.6.26",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "effect": "4.0.0-rc.111",
      "esbuild": "^0.28.1",
      "eslint": "^10.8.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.3",
      "globals": "^17.9.0",
      "lintcn": "^0.10.1",
      "lucide-react": "^1.30.0",
      "miniflare": "^5.20260801.1-alpha",
      "oxfmt": "0.62.0",
      "oxlint": "1.77.0",
      "oxlint-tsgolint": "7.0.2001",
      "pglite-test": "^1.0.3",
      "playwright": "^1.62.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "sqlfu": "0.1.1",
      "storybook": "^10.5.7",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "typescript-eslint": "^8.66.0",
      "vaul": "^1.1.2",
      "vite": "^8.2.1",
      "vitest": "4.1.10",
      "fallow": "3.14.0"
    }
  },
  "scripts": {
    "prepare": "if [ -d .git ] && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "turbo run dev --filter=@effect-coffee-shop/web",
    "storybook": "turbo run storybook --filter=@effect-coffee-shop/web",
    "build-storybook": "turbo run build-storybook --filter=@effect-coffee-shop/web",
    "test:storybook": "turbo run test --filter=@effect-coffee-shop/web",
    "cf:configure": "alchemy configure",
    "cf:login": "alchemy login cloudflare",
    "cf:run": "alchemy run ./infra/alchemy/cloudflare.ts",
    "cf:dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:deploy": "alchemy deploy ./infra/alchemy/cloudflare.ts",
    "cf:destroy": "alchemy destroy ./infra/alchemy/cloudflare.ts",
    "cf:state:tree": "alchemy state tree ./infra/alchemy/cloudflare.ts",
    "cf:state:list": "alchemy state list ./infra/alchemy/cloudflare.ts",
    "infra:run": "alchemy run ./alchemy.run.ts",
    "infra:dev": "alchemy dev ./alchemy.run.ts",
    "infra:deploy": "alchemy deploy ./alchemy.run.ts",
    "infra:destroy": "alchemy destroy ./alchemy.run.ts",
    "infra:state:tree": "alchemy state tree ./alchemy.run.ts",
    "infra:state:list": "alchemy state list ./alchemy.run.ts",
    "aws:run": "alchemy run ./infra/alchemy/aws.ts",
    "aws:deploy": "alchemy deploy ./infra/alchemy/aws.ts",
    "aws:destroy": "alchemy destroy ./infra/alchemy/aws.ts",
    "http": "bun run --cwd apps/backend http",
    "cli": "bun run --cwd apps/backend cli",
    "mcp:stdio": "bun run --cwd apps/backend mcp:stdio",
    "mcp:http": "bun run --cwd apps/backend mcp:http",
    "dev:local:api": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless api.coffee bash scripts/dev-local-api.sh",
    "dev:local:ui": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless coffee bash scripts/dev-local-ui.sh",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "bun run --cwd apps/backend lint:fix",
    "lint:custom": "turbo run lint:custom",
    "lint:custom:build": "bun run --cwd apps/backend lint:custom:build",
    "lint:custom:list": "bun run --cwd apps/backend lint:custom:list",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "build-storybook:affected": "turbo run build-storybook --affected",
    "check": "turbo run typecheck lint fmt:check test && bun run lint:custom && bun run fallow",
    "check:affected": "turbo run typecheck lint fmt:check test --affected && bun run lint:custom && bun run fallow:audit",
    "test": "turbo run test",
    "test:local:full": "bash scripts/test-local-full.sh",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "lint:custom:affected": "bun run lint:custom",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "tsgo:patch": "effect-tsgo patch",
    "tsgo:unpatch": "effect-tsgo unpatch",
    "hooks:install": "prek install --overwrite --prepare-hooks",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push",
    "fallow": "fallow --summary",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health",
    "fallow:audit": "fallow audit --changed-since origin/main",
    "fallow:ci": "fallow --ci",
    "fallow:health:baseline": "fallow health --save-baseline .fallow/health-baseline.json --baseline-mode identity"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-runtime-cloudflare": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.34.0",
    "@j178/prek": "0.4.12",
    "@mpsuesser/oxlint-plugin-effect": "^0.4.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "turbo": "^2.10.8"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "@just-be/effect-typed-id@0.5.0": "patches/@just-be%2Feffect-typed-id@0.5.0.patch",
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  }
}
