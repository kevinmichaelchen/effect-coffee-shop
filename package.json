{
  "name": "effect-coffee-shop",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/http-routing",
      "packages/ui-kit",
      "packages/coffee/domain",
      "packages/coffee/application",
      "packages/coffee/auth",
      "packages/coffee/server",
      "packages/coffee/routes",
      "packages/coffee/presentation/*",
      "packages/turbo-cache",
      "infra/*",
      "packages/tooling"
    ],
    "catalog": {
      "@alchemy.run/aws": "2.0.0-beta.87",
      "@alchemy.run/cloudflare": "2.0.0-beta.87",
      "@alchemy.run/docker": "2.0.0-beta.87",
      "@alchemy.run/domain": "2.0.0-beta.87",
      "@alchemy.run/rivet": "2.0.0-beta.87",
      "@alchemy.run/test": "2.0.0-beta.87",
      "@cloudflare/workers-types": "5.20261031.1",
      "@effect/platform-browser": "4.1.4",
      "@effect/platform-bun": "4.1.4",
      "@effect/platform-node": "4.1.4",
      "@effect/sql-d1": "4.1.4",
      "@effect/tsgo": "0.69.0",
      "@effect/vitest": "4.1.4",
      "@foldkit/oxlint-plugin": "0.15.4",
      "@foldkit/ui": "0.170.0",
      "@foldkit/vite-plugin": "0.29.0",
      "@huggingface/tokenizers": "0.2.0",
      "@huggingface/transformers": "4.3.2",
      "@mpsuesser/oxlint-plugin-effect": "0.6.0",
      "@oxlint/plugins": "1.93.0",
      "@simplewebauthn/browser": "14.0.0",
      "@simplewebauthn/server": "14.0.3",
      "@tailwindcss/vite": "^4.3.5",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.6",
      "@yielded/auth": "0.1.0-beta.47",
      "@yielded/auth-persistence": "0.1.0-beta.47",
      "@yielded/auth-simplewebauthn": "0.1.0-beta.47",
      "alchemy": "2.0.0-beta.87",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "effect": "4.1.4",
      "effect-wide-event": "0.6.0",
      "fallow": "3.43.1",
      "foldkit": "0.170.0",
      "happy-dom": "^21.0.4",
      "onnxruntime-node": "1.31.1",
      "onnxruntime-web": "1.31.1",
      "oxfmt": "0.78.0",
      "oxlint": "1.93.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.5",
      "tsrs": "0.25.0-ts7.1.0-beta",
      "vite": "^8.3.8",
      "vitest": "5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1 && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:profile": "alchemy profile",
    "cf:profile:edit": "alchemy profile edit --add Cloudflare",
    "cf:plan": "alchemy plan ./infra/alchemy/cloudflare.ts",
    "cf:dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:deploy": "alchemy deploy ./infra/alchemy/cloudflare.ts",
    "cf:destroy": "alchemy destroy ./infra/alchemy/cloudflare.ts",
    "cf:test": "turbo run test:integration --filter=@effect-coffee-shop/infra-alchemy",
    "rivet:dev": "alchemy dev ./infra/alchemy/rivet.ts",
    "rivet:test": "turbo run test:rivet --filter=@effect-coffee-shop/infra-alchemy",
    "cf:state:tree": "alchemy state list --recursive --config ./infra/alchemy/cloudflare.ts",
    "cf:state:list": "alchemy state list --config ./infra/alchemy/cloudflare.ts",
    "infra:plan": "alchemy plan ./infra/alchemy/alchemy.run.ts",
    "infra:dev": "alchemy dev ./infra/alchemy/alchemy.run.ts",
    "infra:deploy": "alchemy deploy ./infra/alchemy/alchemy.run.ts",
    "infra:destroy": "alchemy destroy ./infra/alchemy/alchemy.run.ts",
    "infra:state:tree": "alchemy state list --recursive --config ./infra/alchemy/alchemy.run.ts",
    "infra:state:list": "alchemy state list --config ./infra/alchemy/alchemy.run.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt //#fmt:root",
    "fmt:check": "turbo run fmt:check //#fmt:check:root",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "check": "turbo run typecheck lint fmt:check test build //#fmt:check:root //#fallow",
    "check:release": "turbo run typecheck lint fmt:check test test:integration test:rivet build //#fmt:check:root //#fallow //#fallow:typed",
    "check:affected": "TURBO_SCM_BASE=${PRE_COMMIT_FROM_REF:-origin/main} TURBO_SCM_HEAD=${PRE_COMMIT_TO_REF:-HEAD} turbo run typecheck lint fmt:check test build //#fmt:check:root //#fallow --affected",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "hooks:install": "prek install --overwrite --prepare-hooks",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push",
    "fallow": "fallow --summary --no-type-aware && fallow dead-code --production --summary",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --no-type-aware",
    "fallow:audit": "fallow audit",
    "fallow:typed": "fallow health --summary",
    "fallow:health:baseline": "fallow health --no-type-aware --save-baseline fallow-baselines/health.json --baseline-mode identity",
    "cache:dev": "alchemy dev ./infra/turbo-cache/cloudflare.ts",
    "cache:deploy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:deploy:aws": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:test": "turbo run test:integration --filter=@effect-coffee-shop/infra-turbo-cache",
    "cache:env": "varlock load --path infra/turbo-cache/",
    "cache:destroy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:destroy:aws": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:run": "varlock run --path config/turbo-cache/ --",
    "fmt:root": "oxfmt --write package.json .fallowrc.jsonc turbo.json prek.toml '*.md' 'docs/**/*.md' '.agents/**/*.md'",
    "fmt:check:root": "oxfmt --check package.json .fallowrc.jsonc turbo.json prek.toml '*.md' 'docs/**/*.md' '.agents/**/*.md'",
    "patches:check": "bun patches/check.ts"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@j178/prek": "0.5.10",
    "alchemy": "catalog:",
    "fallow": "catalog:",
    "fallow-type-aware": "3.43.1",
    "oxfmt": "catalog:",
    "tsrs": "catalog:",
    "turbo": "2.11.11",
    "varlock": "1.25.0"
  },
  "overrides": {
    "@effect/platform-browser": "4.1.4",
    "@effect/platform-node-shared": "4.1.4",
    "@effect/sql-d1": "4.1.4",
    "@effect/vitest": "4.1.4",
    "effect": "4.1.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@alchemy.run/rivet@2.0.0-beta.87": "patches/@alchemy.run%2Frivet@2.0.0-beta.87.patch",
    "alchemy@2.0.0-beta.87": "patches/alchemy@2.0.0-beta.87.patch",
    "@yielded/auth-persistence@0.1.0-beta.47": "patches/@yielded%2Fauth-persistence@0.1.0-beta.47.patch"
  }
}
