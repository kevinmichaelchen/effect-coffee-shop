{
  "name": "effect-coffee-shop",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/http-routing",
      "packages/ui-kit",
      "packages/coffee/domain",
      "packages/coffee/application",
      "packages/coffee/auth",
      "packages/coffee/server",
      "packages/coffee/routes",
      "packages/coffee/presentation/*",
      "packages/turbo-cache",
      "infra/*",
      "packages/tooling"
    ],
    "catalog": {
      "@alchemy.run/aws": "https://pkg.alchemy.run/@alchemy.run/aws/-/c546b71e8fd1e4ae5f6ca2bbddfcb4d332073cdec2062572d933df8f1982347d.tgz",
      "@alchemy.run/cloudflare": "https://pkg.alchemy.run/@alchemy.run/cloudflare/-/158730a42b9e2c127ac199f7fea7f00466b010e71df888bc24f6b3986c88bf07.tgz",
      "@alchemy.run/docker": "https://pkg.alchemy.run/@alchemy.run/docker/-/1e14476f9620c314db91ee96a51b41acad477816b39ba1c479fb3e13bdc93917.tgz",
      "@alchemy.run/domain": "https://pkg.alchemy.run/@alchemy.run/domain/-/856425e9c40134a87ef20d5a16804eaf4f8d28e79ed753ff395ac6630e17bfc9.tgz",
      "@alchemy.run/rivet": "https://pkg.alchemy.run/@alchemy.run/rivet/-/a8ae58ce2483523b5f9fdbbbc97fd1052099e36add895d269f95caa0c2077067.tgz",
      "@alchemy.run/test": "2.0.0-beta.87",
      "@cloudflare/workers-types": "5.20261120.1",
      "@effect/platform-browser": "4.1.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/platform-node": "4.1.5",
      "@effect/sql-d1": "4.1.5",
      "@effect/tsgo": "0.73.2",
      "@effect/vitest": "4.1.5",
      "@foldkit/oxlint-plugin": "0.15.4",
      "@foldkit/ui": "0.171.0",
      "@foldkit/vite-plugin": "0.29.1",
      "@huggingface/tokenizers": "0.2.0",
      "@huggingface/transformers": "4.3.2",
      "@mpsuesser/oxlint-plugin-effect": "0.6.0",
      "@oxlint/plugins": "1.94.0",
      "@simplewebauthn/browser": "14.0.0",
      "@simplewebauthn/server": "14.1.0",
      "@tailwindcss/vite": "^4.3.5",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.6",
      "@yielded/auth": "0.1.0-beta.49",
      "@yielded/auth-persistence": "0.1.0-beta.49",
      "@yielded/auth-simplewebauthn": "0.1.0-beta.49",
      "alchemy": "https://pkg.alchemy.run/alchemy/-/6ca328742a59419cfb9e01f2c182f3c92fe081d7706f11c8814bce9a02b2682a.tgz",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "effect": "4.1.5",
      "effect-wide-event": "0.6.0",
      "fallow": "3.45.0",
      "foldkit": "0.171.0",
      "happy-dom": "^21.0.4",
      "onnxruntime-node": "1.31.1",
      "onnxruntime-web": "1.31.1",
      "oxfmt": "0.79.0",
      "oxlint": "1.94.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.5",
      "tsrs": "7.1.0-beta.tsrs3",
      "vite": "^8.3.8",
      "vitest": "5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1 && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:plan": "alchemy plan ./infra/alchemy/cloudflare.ts",
    "cf:deploy": "alchemy deploy ./infra/alchemy/cloudflare.ts",
    "cf:destroy": "alchemy destroy ./infra/alchemy/cloudflare.ts",
    "cf:test": "turbo run test:integration --filter=@effect-coffee-shop/infra-alchemy",
    "rivet:dev": "alchemy dev ./infra/alchemy/rivet.ts",
    "rivet:test": "turbo run test:rivet --filter=@effect-coffee-shop/infra-alchemy",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt //#fmt:root",
    "fmt:check": "turbo run fmt:check //#fmt:check:root",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "check": "turbo run lint fmt:check test build //#fmt:check:root //#fallow",
    "check:release": "turbo run lint fmt:check test test:integration test:rivet build //#fmt:check:root //#fallow //#fallow:typed",
    "check:affected": "TURBO_SCM_BASE=${PRE_COMMIT_FROM_REF:-origin/main} TURBO_SCM_HEAD=${PRE_COMMIT_TO_REF:-HEAD} turbo run lint fmt:check test build //#fmt:check:root //#fallow --affected",
    "test": "turbo run test",
    "fallow": "fallow --summary --no-type-aware && fallow dead-code --production --summary",
    "fallow:typed": "fallow health --summary",
    "fallow:health:baseline": "fallow health --no-type-aware --save-baseline fallow-baselines/health.json --baseline-mode identity",
    "cache:dev": "alchemy dev ./infra/turbo-cache/cloudflare.ts",
    "cache:deploy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:deploy:aws": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:test": "turbo run test:integration --filter=@effect-coffee-shop/infra-turbo-cache",
    "cache:env": "varlock load --path infra/turbo-cache/",
    "cache:destroy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:destroy:aws": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:run": "varlock run --path config/turbo-cache/ --",
    "fmt:root": "oxfmt --write package.json .fallowrc.jsonc turbo.json prek.toml '*.md' 'docs/**/*.md' '.agents/**/*.md'",
    "fmt:check:root": "oxfmt --check package.json .fallowrc.jsonc turbo.json prek.toml '*.md' 'docs/**/*.md' '.agents/**/*.md'",
    "patches:check": "bun patches/check.ts"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "https://pkg.alchemy.run/@alchemy.run/frontend-frameworks/-/da594b557b7ae990a01045b994ff49bb3f49bc8a8f5bbe728bacb284e309c7ce.tgz",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@j178/prek": "0.5.11",
    "alchemy": "catalog:",
    "fallow": "catalog:",
    "fallow-type-aware": "3.45.0",
    "oxfmt": "catalog:",
    "tsrs": "catalog:",
    "turbo": "2.11.11",
    "varlock": "1.25.0"
  },
  "overrides": {
    "@effect/platform-browser": "4.1.5",
    "@effect/platform-node-shared": "4.1.5",
    "@effect/sql-d1": "4.1.5",
    "@effect/vitest": "4.1.5",
    "alchemy": "https://pkg.alchemy.run/alchemy/-/6ca328742a59419cfb9e01f2c182f3c92fe081d7706f11c8814bce9a02b2682a.tgz",
    "effect": "4.1.5"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@yielded/auth-persistence@0.1.0-beta.49": "patches/@yielded%2Fauth-persistence@0.1.0-beta.49.patch",
    "@alchemy.run/rivet@https://pkg.alchemy.run/@alchemy.run/rivet/-/a8ae58ce2483523b5f9fdbbbc97fd1052099e36add895d269f95caa0c2077067.tgz": "patches/@alchemy.run%2Frivet@2.0.0-beta.87.patch"
  }
}
