{
  "name": "effect-v4-onion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "ui"],
  "scripts": {
    "dev": "turbo run dev --filter=ui",
    "http": "bun run --cwd backend http",
    "cli": "bun run --cwd backend cli",
    "mcp:stdio": "bun run --cwd backend mcp:stdio",
    "mcp:http": "bun run --cwd backend mcp:http",
    "dev:onion:api": "PORTLESS_STATE_DIR=/tmp/effect-v4-onion-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless api.onion bash scripts/dev-onion-api.sh",
    "dev:onion:ui": "PORTLESS_STATE_DIR=/tmp/effect-v4-onion-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless onion bash scripts/dev-onion-ui.sh",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "bun run --cwd backend lint:fix",
    "lint:custom": "turbo run lint:custom",
    "lint:custom:build": "bun run --cwd backend lint:custom:build",
    "lint:custom:list": "bun run --cwd backend lint:custom:list",
    "fmt": "bun run --cwd backend fmt",
    "fmt:check": "turbo run fmt:check",
    "knip": "turbo run knip",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "check": "turbo run typecheck lint lint:custom fmt:check test",
    "check:affected": "turbo run typecheck lint lint:custom fmt:check test --affected",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "lint:custom:affected": "turbo run lint:custom --affected",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "hooks:install": "prek install --overwrite",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push"
  },
  "devDependencies": {
    "@j178/prek": "0.3.8",
    "turbo": "^2.9.2"
  },
  "packageManager": "bun@1.3.11"
}
