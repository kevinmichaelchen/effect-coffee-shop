{
  "name": "effect-coffee-shop",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/http-routing",
      "packages/coffee/domain",
      "packages/coffee/application",
      "packages/ui-kit",
      "packages/coffee/auth",
      "packages/coffee/backend",
      "packages/coffee/external/*",
      "packages/coffee/presentation/*",
      "packages/coffee/runtime/*",
      "packages/turbo-cache",
      "infra/*",
      "packages/tooling",
      "packages/coffee/testing"
    ],
    "catalog": {
      "@better-auth/drizzle-adapter": "1.6.26",
      "@better-auth/passkey": "^1.6.26",
      "@alchemy.run/cloudflare-runtime": "https://pkg.alchemy.run/@alchemy.run/cloudflare-runtime/-/5e84ea1c9c9e6a205275b1b5550e3b01d5fa941a36f01f44179ba897c078eecb.tgz",
      "@cloudflare/workers-types": "5.20260818.1",
      "@effect/platform-bun": "4.0.0-rc.115",
      "@effect/platform-node": "4.0.0-rc.115",
      "@effect/sql-d1": "4.0.0-rc.115",
      "@effect/sql-pg": "4.0.0-rc.115",
      "@effect/sql-pglite": "4.0.0-rc.115",
      "@effect/sql-sqlite-bun": "4.0.0-rc.115",
      "@effect/vitest": "4.0.0-rc.115",
      "@electric-sql/pglite": "^0.5.4",
      "@radix-ui/react-dialog": "^1.1.23",
      "@radix-ui/react-label": "^2.1.15",
      "@radix-ui/react-progress": "^1.1.16",
      "@radix-ui/react-select": "^2.3.7",
      "@radix-ui/react-slot": "^1.3.3",
      "@storybook/addon-a11y": "^10.5.7",
      "@storybook/addon-docs": "^10.5.7",
      "@storybook/addon-vitest": "^10.5.7",
      "@storybook/react-vite": "^10.5.7",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-query": "^5.101.4",
      "@types/bun": "^1.3.14",
      "@types/node": "^26.1.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "@vitest/browser": "^4.1.10",
      "@vitest/browser-playwright": "^4.1.10",
      "alchemy": "https://pkg.alchemy.run/alchemy/edb8192a67b375730d768006b4fc507271f291bd",
      "better-auth": "^1.6.26",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "effect": "4.0.0-rc.115",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.3",
      "lintcn": "^0.10.1",
      "lucide-react": "^1.30.0",
      "oxfmt": "0.68.0",
      "oxlint": "1.83.0",
      "oxlint-tsgolint": "7.0.2001",
      "pglite-test": "^1.0.3",
      "playwright": "^1.62.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "sqlfu": "0.1.1",
      "storybook": "^10.5.7",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "7.0.2",
      "vaul": "^1.1.2",
      "vite": "^8.2.1",
      "vitest": "4.1.10",
      "fallow": "3.25.0",
      "@mpsuesser/oxlint-plugin-effect": "0.5.0",
      "@shadcn/lint": "0.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript-package ./packages/tooling/node_modules/typescript && if git rev-parse --git-dir >/dev/null 2>&1 && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "turbo run dev --filter=@effect-coffee-shop/web",
    "storybook": "turbo run storybook --filter=@effect-coffee-shop/web",
    "build-storybook": "turbo run build-storybook --filter=@effect-coffee-shop/web",
    "test:storybook": "turbo run test --filter=@effect-coffee-shop/web",
    "cf:profile": "alchemy profile",
    "cf:profile:edit": "alchemy profile edit --add cloudflare",
    "cf:plan": "alchemy plan ./infra/alchemy/cloudflare.ts",
    "cf:dev": "alchemy dev ./infra/alchemy/cloudflare.ts",
    "cf:deploy": "alchemy deploy ./infra/alchemy/cloudflare.ts",
    "cf:destroy": "alchemy destroy ./infra/alchemy/cloudflare.ts",
    "cf:test": "turbo run test --filter=@effect-coffee-shop/infra-alchemy",
    "cf:state:tree": "alchemy state list --recursive --config ./infra/alchemy/cloudflare.ts",
    "cf:state:list": "alchemy state list --config ./infra/alchemy/cloudflare.ts",
    "infra:plan": "alchemy plan ./infra/alchemy/alchemy.run.ts",
    "infra:dev": "alchemy dev ./infra/alchemy/alchemy.run.ts",
    "infra:deploy": "alchemy deploy ./infra/alchemy/alchemy.run.ts",
    "infra:destroy": "alchemy destroy ./infra/alchemy/alchemy.run.ts",
    "infra:state:tree": "alchemy state list --recursive --config ./infra/alchemy/alchemy.run.ts",
    "infra:state:list": "alchemy state list --config ./infra/alchemy/alchemy.run.ts",
    "aws:plan": "alchemy plan ./infra/alchemy/aws.ts",
    "aws:deploy": "alchemy deploy ./infra/alchemy/aws.ts",
    "aws:destroy": "alchemy destroy ./infra/alchemy/aws.ts",
    "http": "bun run --cwd apps/backend http",
    "cli": "bun run --cwd apps/backend cli",
    "mcp:stdio": "bun run --cwd apps/backend mcp:stdio",
    "mcp:http": "bun run --cwd apps/backend mcp:http",
    "dev:local:api": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless api.coffee bash scripts/dev-local-api.sh",
    "dev:local:ui": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless coffee bash scripts/dev-local-ui.sh",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "bun run --cwd apps/backend lint:fix",
    "lint:custom": "turbo run lint:custom",
    "lint:custom:build": "bun run --cwd packages/tooling lint:custom:build",
    "lint:custom:list": "bun run --cwd packages/tooling lint:custom:list",
    "fmt": "turbo run fmt && bun run fmt:root",
    "fmt:check": "turbo run fmt:check //#fmt:check:root",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "build-storybook:affected": "turbo run build-storybook --affected",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run lint:custom && bun run test && bun run build && bun run fallow && bun run knip && bun run knip:production",
    "check:affected": "turbo run typecheck lint fmt:check test build --affected && turbo run lint:custom //#fmt:check:root && bun run fallow && bun run knip && bun run knip:production",
    "test": "turbo run test",
    "test:local:full": "bash scripts/test-local-full.sh",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "lint:custom:affected": "bun run lint:custom",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "tsgo:patch": "effect-tsgo patch --typescript-package ./packages/tooling/node_modules/typescript",
    "tsgo:unpatch": "effect-tsgo unpatch --typescript-package ./packages/tooling/node_modules/typescript",
    "hooks:install": "prek install --overwrite --prepare-hooks",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push",
    "fallow": "fallow --summary --skip health && fallow health --summary --no-type-aware",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --no-type-aware",
    "fallow:audit": "fallow audit --changed-since origin/main",
    "fallow:ci": "fallow --ci --skip health && fallow health --ci --no-type-aware",
    "fallow:health:baseline": "fallow health --no-type-aware --save-baseline .fallow/health-baseline.json --baseline-mode identity",
    "ci:static": "turbo run typecheck lint fmt:check",
    "ci:backend": "turbo run test --concurrency=2 --filter=!@effect-coffee-shop/web",
    "ci:ui": "turbo run test build --filter=@effect-coffee-shop/web",
    "cache:dev": "alchemy dev ./infra/turbo-cache/cloudflare.ts",
    "cache:deploy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:deploy:aws": "varlock run --path infra/turbo-cache/ -- alchemy deploy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:test": "turbo run test --filter=@effect-coffee-shop/infra-turbo-cache",
    "cache:env": "varlock load --path infra/turbo-cache/",
    "cache:destroy:cloudflare": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/cloudflare.ts --stage prod",
    "cache:destroy:aws": "varlock run --path infra/turbo-cache/ -- alchemy destroy ./infra/turbo-cache/aws.ts --stage prod",
    "cache:run": "varlock run --path config/turbo-cache/ --",
    "knip": "knip --cache --treat-config-hints-as-errors --include nsExports,nsTypes",
    "fmt:root": "oxfmt --write package.json knip.jsonc .fallowrc.jsonc turbo.json",
    "fmt:check:root": "oxfmt --check package.json knip.jsonc .fallowrc.jsonc turbo.json",
    "knip:production": "knip --cache --strict --treat-config-hints-as-errors --include nsExports,nsTypes"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/tsgo": "0.41.0",
    "@j178/prek": "0.5.3",
    "alchemy": "catalog:",
    "fallow": "catalog:",
    "knip": "6.35.1",
    "oxfmt": "catalog:",
    "turbo": "2.10.12",
    "varlock": "1.18.0"
  },
  "overrides": {
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@just-be/effect-typed-id@0.5.0": "patches/@just-be%2Feffect-typed-id@0.5.0.patch",
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  }
}
