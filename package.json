{
  "name": "effect-coffee-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/backend-host", "packages/coffee/core", "packages/coffee/actions", "packages/coffee/assistant", "packages/coffee/auth", "packages/coffee/external/*", "packages/coffee/presentation/*"],
    "catalog": {
      "@better-auth/agent-auth": "0.4.5",
      "@better-auth/passkey": "^1.6.9",
      "@cloudflare/workers-types": "^4.20260508.1",
      "@effect/platform-bun": "4.0.0-beta.64",
      "@effect/platform-node": "4.0.0-beta.64",
      "@effect/sql-d1": "4.0.0-beta.64",
      "@effect/sql-sqlite-bun": "4.0.0-beta.64",
      "@effect/vitest": "4.0.0-beta.64",
      "@eslint/js": "^10.0.1",
      "@radix-ui/react-dialog": "^1.1.15",
      "@radix-ui/react-label": "^2.1.8",
      "@radix-ui/react-progress": "^1.1.8",
      "@radix-ui/react-select": "^2.2.6",
      "@radix-ui/react-slot": "^1.2.4",
      "@storybook/addon-a11y": "^10.3.6",
      "@storybook/addon-docs": "^10.3.6",
      "@storybook/addon-vitest": "^10.3.6",
      "@storybook/react-vite": "^10.3.6",
      "@tailwindcss/vite": "^4.2.4",
      "@tanstack/ai": "0.14.0",
      "@tanstack/ai-client": "0.8.0",
      "@tanstack/ai-react": "0.8.0",
      "@tanstack/react-query": "^5.100.9",
      "@types/bun": "^1.3.13",
      "@types/node": "^25.6.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.1",
      "@vitest/browser": "^4.1.5",
      "@vitest/browser-playwright": "^4.1.5",
      "better-auth": "^1.6.9",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "effect": "4.0.0-beta.64",
      "esbuild": "^0.28.0",
      "eslint": "^10.3.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.2",
      "globals": "^17.6.0",
      "lintcn": "^0.10.0",
      "lucide-react": "^1.14.0",
      "miniflare": "^4.20260507.1",
      "oxfmt": "0.48.0",
      "oxlint": "1.63.0",
      "oxlint-tsgolint": "0.22.1",
      "playwright": "^1.59.1",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "sonner": "^2.0.7",
      "sqlfu": "0.0.3-14",
      "storybook": "^10.3.6",
      "tailwind-merge": "^3.5.0",
      "tailwindcss": "^4.2.4",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.59.2",
      "vaul": "^1.1.2",
      "vite": "^8.0.11",
      "vitest": "4.1.5",
      "fallow": "2.67.0"
    }
  },
  "scripts": {
    "prepare": "if [ -d .git ] && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "turbo run dev --filter=@effect-coffee-shop/web",
    "storybook": "turbo run storybook --filter=@effect-coffee-shop/web",
    "build-storybook": "turbo run build-storybook --filter=@effect-coffee-shop/web",
    "test:storybook": "turbo run test --filter=@effect-coffee-shop/web",
    "cf:configure": "alchemy configure",
    "cf:login": "alchemy login cloudflare",
    "cf:run": "alchemy run ./alchemy.run.ts",
    "cf:dev": "alchemy dev ./alchemy.run.ts",
    "cf:deploy": "alchemy deploy ./alchemy.run.ts",
    "cf:destroy": "alchemy destroy ./alchemy.run.ts",
    "cf:state:tree": "alchemy state tree ./alchemy.run.ts",
    "cf:state:list": "alchemy state list ./alchemy.run.ts",
    "http": "bun run --cwd apps/backend http",
    "cli": "bun run --cwd apps/backend cli",
    "mcp:stdio": "bun run --cwd apps/backend mcp:stdio",
    "mcp:http": "bun run --cwd apps/backend mcp:http",
    "dev:local:api": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless api.coffee bash scripts/dev-local-api.sh",
    "dev:local:ui": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless coffee bash scripts/dev-local-ui.sh",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "bun run --cwd apps/backend lint:fix",
    "lint:custom": "turbo run lint:custom",
    "lint:custom:build": "bun run --cwd apps/backend lint:custom:build",
    "lint:custom:list": "bun run --cwd apps/backend lint:custom:list",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "build-storybook:affected": "turbo run build-storybook --affected",
    "check": "turbo run typecheck lint fmt:check test && bun run lint:custom && bun run fallow",
    "check:affected": "turbo run typecheck lint fmt:check test --affected && bun run lint:custom && bun run fallow:audit",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "lint:custom:affected": "bun run lint:custom",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "tsgo:patch": "effect-tsgo patch",
    "tsgo:unpatch": "effect-tsgo unpatch",
    "hooks:install": "prek install --overwrite --prepare-hooks",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push",
    "fallow": "fallow --summary",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health",
    "fallow:audit": "fallow audit --changed-since origin/main",
    "fallow:ci": "fallow --ci"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260508.1",
    "@effect/platform-bun": "4.0.0-beta.64",
    "@effect/platform-node": "4.0.0-beta.64",
    "@effect/tsgo": "0.5.2",
    "@j178/prek": "0.3.13",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "alchemy": "2.0.0-beta.36",
    "effect": "4.0.0-beta.64",
    "turbo": "^2.9.10",
    "fallow": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
