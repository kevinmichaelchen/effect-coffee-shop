{
  "name": "effect-coffee-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "ui"],
  "scripts": {
    "prepare": "if [ -d .git ] && [ -z \"$CI\" ]; then prek install --overwrite --prepare-hooks; fi",
    "dev": "turbo run dev --filter=ui",
    "storybook": "turbo run storybook --filter=ui",
    "build-storybook": "turbo run build-storybook --filter=ui",
    "test:storybook": "turbo run test --filter=ui",
    "cf:configure": "alchemy configure",
    "cf:login": "alchemy login cloudflare",
    "cf:run": "alchemy run ./alchemy.run.ts",
    "cf:dev": "alchemy dev ./alchemy.run.ts",
    "cf:deploy": "alchemy deploy ./alchemy.run.ts",
    "cf:destroy": "alchemy destroy ./alchemy.run.ts",
    "cf:state:tree": "alchemy state tree ./alchemy.run.ts",
    "cf:state:list": "alchemy state list ./alchemy.run.ts",
    "cf:run:otel-collector": "alchemy run ./ops/otel-collector-cloudflare/alchemy.run.ts",
    "cf:dev:otel-collector": "alchemy dev ./ops/otel-collector-cloudflare/alchemy.run.ts",
    "cf:deploy:otel-collector": "alchemy deploy ./ops/otel-collector-cloudflare/alchemy.run.ts",
    "cf:destroy:otel-collector": "alchemy destroy ./ops/otel-collector-cloudflare/alchemy.run.ts",
    "cf:state:tree:otel-collector": "alchemy state tree ./ops/otel-collector-cloudflare/alchemy.run.ts",
    "cf:state:list:otel-collector": "alchemy state list ./ops/otel-collector-cloudflare/alchemy.run.ts",
    "http": "bun run --cwd backend http",
    "cli": "bun run --cwd backend cli",
    "mcp:stdio": "bun run --cwd backend mcp:stdio",
    "mcp:http": "bun run --cwd backend mcp:http",
    "dev:local:api": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless api.coffee bash scripts/dev-local-api.sh",
    "dev:local:ui": "PORTLESS_STATE_DIR=/tmp/effect-coffee-shop-portless PORTLESS_PORT=1365 PORTLESS_HTTPS=0 PORTLESS_SYNC_HOSTS=0 portless coffee bash scripts/dev-local-ui.sh",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "bun run --cwd backend lint:fix",
    "lint:custom": "bun run --cwd backend lint:custom && bun run --cwd ui lint:custom",
    "lint:custom:build": "bun run --cwd backend lint:custom:build",
    "lint:custom:list": "bun run --cwd backend lint:custom:list",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "knip": "turbo run knip",
    "build": "turbo run build",
    "build:affected": "turbo run build --affected",
    "build-storybook:affected": "turbo run build-storybook --affected",
    "check": "turbo run typecheck lint fmt:check knip test && bun run lint:custom",
    "check:affected": "turbo run typecheck lint fmt:check knip test --affected && bun run lint:custom",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "lint:affected": "turbo run lint --affected",
    "lint:custom:affected": "bun run lint:custom",
    "affected:packages": "turbo query affected --packages",
    "affected:tasks": "turbo query affected",
    "tsgo:patch": "effect-tsgo patch",
    "tsgo:unpatch": "effect-tsgo unpatch",
    "hooks:install": "prek install --overwrite --prepare-hooks",
    "hooks:run:pre-commit": "prek run --all-files --stage pre-commit",
    "hooks:run:pre-push": "prek run --all-files --stage pre-push"
  },
  "devDependencies": {
    "@effect/tsgo": "0.5.2",
    "@j178/prek": "0.3.13",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "alchemy": "0.93.7",
    "turbo": "^2.9.10"
  },
  "packageManager": "bun@1.3.11"
}
