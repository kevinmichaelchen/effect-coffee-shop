direction: down

classes: {
  app: {
    style.fill: "#E7F0FF"
    style.stroke: "#2563EB"
  }
  presentation: {
    style.fill: "#ECFDF5"
    style.stroke: "#059669"
  }
  application: {
    style.fill: "#FFF7ED"
    style.stroke: "#EA580C"
  }
  domain: {
    style.fill: "#FEF2F2"
    style.stroke: "#DC2626"
  }
  external: {
    style.fill: "#F5F3FF"
    style.stroke: "#7C3AED"
  }
}

infra: "infra/alchemy\nCloudflare stack" {
  class: app
}

ui: "apps/ui\nFoldkit app + Website Worker" {
  class: app
}

server: "coffee-server\nCoffee Worker, composition root\nDurable Objects, D1, Secrets Store" {
  class: app
}

presentation: "presentation\nREST (health, menu, me), MCP" {
  class: presentation
}

actions: "presentation/actions\nshared tool catalog" {
  class: presentation
}

auth: "coffee-auth\nYielded passkeys, MCP OAuth" {
  class: external
}

core: "coffee-application\nCoffeeOrderApp over the model" {
  class: application
}

domain: "coffee-domain\nalchemy/Domain model\naggregates, views, policy, Apis" {
  class: domain
}

infra -> server: "deploys"
infra -> ui: "deploys"
ui -> domain: "Api clients"
server -> presentation: "mounts"
server -> auth: "sessions"
server -> domain: "hosts model + Apis"
presentation -> actions: "project tools"
presentation -> core: "call"
actions -> core: "run"
core -> domain: "commands + views"
