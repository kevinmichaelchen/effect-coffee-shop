direction: down

title: "Effect Coffee Shop Architecture"

classes: {
  app: {
    style.fill: "#E7F0FF"
    style.stroke: "#2563EB"
  }
  presentation: {
    style.fill: "#ECFDF5"
    style.stroke: "#059669"
  }
  application: {
    style.fill: "#FFF7ED"
    style.stroke: "#EA580C"
  }
  domain: {
    style.fill: "#FEF2F2"
    style.stroke: "#DC2626"
  }
  external: {
    style.fill: "#F5F3FF"
    style.stroke: "#7C3AED"
  }
  shared: {
    style.fill: "#F8FAFC"
    style.stroke: "#64748B"
    style.stroke-dash: 4
  }
}

user: "Customers, staff,\nagents, and tests" {
  shape: c4-person
}

backend: "apps/backend\ncomposition root" {
  class: app
  tooltip: "Chooses concrete runtime, persistence, auth, host, and presentation layers."

  runtimes: "runtime entrypoints\nBun, Cloudflare Worker, AWS Lambda" {
    class: app
  }
  mounts: "Fetch surface manifest\nHTTP API, MCP, auth, assistant, discovery, assets" {
    class: app
  }

  layer_composition: "Layer composition\nroute layers + app layers + persistence" {
    class: app
  }
}

host: "packages/backend-host\nruntime-neutral Fetch host" {
  class: shared
  tooltip: "Mount dispatch, path helpers, request services, request logging, metrics, spans, and JSON encoding."
}

presentation: "presentation and adapter packages" {
  class: presentation

  http: "coffee-http\nEffect HTTP API + web handler" {
    class: presentation
  }
  mcp: "coffee-mcp\nMCP resources, prompts, tools, transports" {
    class: presentation
  }
  cli: "coffee-cli\nhuman CLI commands" {
    class: presentation
  }
  assistant: "coffee-assistant\nchat handler, tools, model adapters" {
    class: presentation
  }
  auth: "coffee-auth\nBetter Auth + Agent Auth capability adapter" {
    class: presentation
  }
}

actions: "coffee-actions\nneutral action contracts" {
  class: application
  tooltip: "Shared use-case/tool contracts consumed by MCP, assistant, and Agent Auth."
}

core: "coffee-core\nonion core" {
  class: domain

  app_service: "CoffeeOrderApp\napplication service" {
    class: application
  }
  ports: "repository and clock ports" {
    class: application
  }
  domain: "domain model\nmenu, money, orders, cart" {
    class: domain
  }
}

external: "external implementation packages" {
  class: external

  memory: "in-memory\nlocal/test persistence" {
    class: external
  }
  sqlite: "sqlite / D1\nSQLFU persistence" {
    class: external
  }
  postgres: "drizzle-postgres\nAWS persistence" {
    class: external
  }
  ai: "AI providers\nWorkers AI, REST, Ollama" {
    class: external
  }
}

legend: |md
  **Rule of thumb:** dependencies point inward. Apps choose concrete layers; presentation and adapters translate protocols; actions expose reusable use cases; core owns business behavior. `backend-host` is shared runtime plumbing, not a Coffee onion layer.
| {
  shape: text
  near: bottom-center
}

user -> backend.runtimes: "HTTP, MCP, CLI"
backend.runtimes -> backend.mounts: "dispatches requests"
backend.runtimes -> backend.layer_composition: "starts runtime"
backend.mounts -> host: "uses"
backend.layer_composition -> presentation.http: "selects route layer"
backend.layer_composition -> presentation.mcp: "selects route layer"
backend.layer_composition -> presentation.assistant: "mounts when enabled"
backend.layer_composition -> presentation.auth: "mounts when enabled"
backend.layer_composition -> external.memory: "local/test"
backend.layer_composition -> external.sqlite: "Cloudflare/local"
backend.layer_composition -> external.postgres: "AWS"

presentation.http -> core.app_service: "calls"
presentation.mcp -> actions: "projects"
presentation.cli -> core.app_service: "calls"
presentation.assistant -> actions: "projects tools"
presentation.auth -> actions: "executes capabilities"

actions -> core.app_service: "runs use cases"
core.app_service -> core.ports: "requires"
core.app_service -> core.domain: "enforces"

external.memory -> core.ports: "implements"
external.sqlite -> core.ports: "implements"
external.postgres -> core.ports: "implements"
external.ai -> presentation.assistant: "model runner"

presentation.http -> host: "request services + observability"
presentation.assistant -> host: "observability"
presentation.auth -> host: "observability"
