direction: down

classes: {
  runtime: {
    style.fill: "#E7F0FF"
    style.stroke: "#2563EB"
  }
  host: {
    style.fill: "#F8FAFC"
    style.stroke: "#64748B"
  }
  surface: {
    style.fill: "#ECFDF5"
    style.stroke: "#059669"
  }
  implementation: {
    style.fill: "#FFF7ED"
    style.stroke: "#EA580C"
  }
}

clients: "clients\nbrowser, MCP agents, tests"

website: "Website Worker (apps/ui)\nFoldkit assets; forwards /api, /sync, /mcp, /oauth/, /.well-known/" {
  class: runtime
}

coffee: "Coffee Worker (coffee-server)\none wide event per request" {
  class: host
}

surfaces: "surfaces" {
  class: surface
  domain_apis: "Domain Apis (Effect RPC)\n/api/customer, /api/staff\nactor from session header" {
    class: surface
  }
  sync: "Yielded Sync\n/sync/orders/:id\nsession-authenticated WebSockets" {
    class: surface
  }
  rest: "REST\n/api/health, /api/menu, /api/me\nstatic menu, session actor" {
    class: surface
  }
  mcp: "MCP HTTP\n/mcp (OAuth)" {
    class: surface
  }
  auth: "Yielded Auth + OAuth\n/api/auth/*, /oauth/*, /.well-known/*" {
    class: surface
  }
}

storage: "platform" {
  class: implementation
  model: "CoffeeShop model\nDurable Objects (DomainCloudflare)" {
    class: implementation
  }
  feeds: "Private order feeds\nYielded Sync Durable Objects" {
    class: implementation
  }
  d1: "D1 coffee-db\npasskeys, sessions, OAuth grants" {
    class: implementation
  }
}

clients -> website: "requests"
website -> coffee: "service binding COFFEE"
coffee -> surfaces: "route by path"
surfaces.domain_apis -> storage.model: "commands + views"
surfaces.mcp -> storage.model: "CoffeeOrderApp"
surfaces.auth -> storage.d1

surfaces.sync -> storage.feeds: "snapshots + live events"
storage.model -> storage.feeds: "SyncOrders policy"
