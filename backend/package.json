{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app-layer": "./src/app-layer.ts",
    "#presentation/*": "./src/presentation/*.ts"
  },
  "scripts": {
    "dev": "bun run http",
    "http": "bun run src/presentation/http/main.ts",
    "cli": "bun run src/presentation/cli/main.ts",
    "mcp:stdio": "bun run src/presentation/mcp/stdio-main.ts",
    "mcp:http": "bun run src/presentation/mcp/http-main.ts",
    "dev:local:api": "bun run src/presentation/dev/local-backend-main.ts",
    "db:check": "bun run --cwd ../packages/external-sqlite db:check",
    "db:draft": "bun run --cwd ../packages/external-sqlite db:draft",
    "db:format": "bun run --cwd ../packages/external-sqlite db:format",
    "db:generate": "bun run --cwd ../packages/external-sqlite db:generate",
    "db:migrate": "bun run --cwd ../packages/external-sqlite db:migrate",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config --fix .",
    "lint:custom": "lintcn lint --tsconfig tsconfig.json",
    "lint:custom:build": "lintcn build",
    "lint:custom:list": "lintcn list",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "bench:mcp:miniflare": "bun run scripts/measure-mcp-miniflare.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:custom && bun run fmt:check && bun run knip && bun run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/agent-auth": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@effect-coffee-shop/core": "workspace:*",
    "@effect-coffee-shop/external-in-memory": "workspace:*",
    "@effect-coffee-shop/external-sqlite": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@tanstack/ai": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "find-up": "catalog:",
    "goke": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tar": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
