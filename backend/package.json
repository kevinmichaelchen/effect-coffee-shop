{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#domain/*": "./src/domain/*.ts",
    "#external/*": "./src/external/*.ts",
    "#presentation/*": "./src/presentation/*.ts",
    "#runtime/*": "./src/runtime/*.ts",
    "#service/*": "./src/service/*.ts"
  },
  "scripts": {
    "dev": "bun run http",
    "http": "bun run src/presentation/http/main.ts",
    "cli": "bun run src/presentation/cli/main.ts",
    "mcp:stdio": "bun run src/presentation/mcp/stdio-main.ts",
    "mcp:http": "bun run src/presentation/mcp/http-main.ts",
    "dev:local:api": "bun run src/presentation/dev/local-backend-main.ts",
    "db:check": "sqlfu --config src/external/sql/sqlfu.config.ts check",
    "db:draft": "sqlfu --config src/external/sql/sqlfu.config.ts draft",
    "db:format": "sqlfu --config src/external/sql/sqlfu.config.ts format \"src/external/sql/**/*.sql\"",
    "db:generate": "sqlfu --config src/external/sql/sqlfu.config.ts generate && oxfmt --write \"src/external/sql/**/*.ts\"",
    "db:migrate": "sqlfu --config src/external/sql/sqlfu.config.ts migrate",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config --fix .",
    "lint:custom": "lintcn lint --tsconfig tsconfig.json",
    "lint:custom:build": "lintcn build",
    "lint:custom:list": "lintcn list",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "bench:mcp:miniflare": "bun run scripts/measure-mcp-miniflare.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:custom && bun run fmt:check && bun run knip && bun run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.4.5",
    "@better-auth/passkey": "^1.6.9",
    "@effect/platform-bun": "4.0.0-beta.64",
    "@effect/sql-d1": "4.0.0-beta.64",
    "@effect/sql-sqlite-bun": "4.0.0-beta.64",
    "@tanstack/ai": "0.14.0",
    "better-auth": "^1.6.9",
    "effect": "4.0.0-beta.64",
    "lintcn": "^0.10.0",
    "sqlfu": "0.0.3-14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.1",
    "@effect/platform-node": "4.0.0-beta.64",
    "@effect/vitest": "4.0.0-beta.64",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "find-up": "^8.0.0",
    "goke": "^6.10.0",
    "knip": "^6.12.1",
    "miniflare": "^4.20260507.1",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "tar": "^7.5.15",
    "typescript": "^6.0.3",
    "vitest": "4.1.5"
  },
  "packageManager": "bun@1.3.11"
}
