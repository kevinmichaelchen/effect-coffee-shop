{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  // Focus on application and test code only.
  "entry": [
    "src/presentation/http/main.ts!",
    "src/presentation/cli/main.ts!",
    "src/presentation/mcp/stdio-main.ts!",
    "src/presentation/mcp/http-main.ts!",
    "src/presentation/mcp/miniflare.worker.ts",
    "src/**/*.test.ts",
    "test/**/*.test.ts",
  ],

  "project": ["src/**/*.ts!", "test/**/*.ts"],

  "ignore": [
    "src/external/sql/sqlfu.config.ts",
    "src/external/sql/migrations/.generated/migrations.ts",
    "src/external/sql/queries/.generated/index.ts",
    "src/external/sql/queries/.generated/queries.ts",
    "src/external/sql/queries/.generated/tables.ts",
  ],

  "ignoreDependencies": ["find-up", "ink", "react", "tar"],
}
