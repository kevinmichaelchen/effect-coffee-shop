# Explicit OAuth clients, e.g. [{"clientId":"inspector","name":"MCP Inspector","redirectUris":["http://localhost:6274/oauth/callback"]}]
MCP_CLIENTS=[]
AUTH_SECRET=
COFFEE_STAFF_USER_IDS=
COFFEE_OBSERVABILITY_SAMPLING_RATE=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
