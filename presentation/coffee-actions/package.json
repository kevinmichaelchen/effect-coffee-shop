{
  "name": "@effect-coffee-shop/coffee-actions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./assistant-tool-data": "./src/assistant-tool-data.ts",
    "./schemas": "./src/schemas.ts",
    "./tool-format": "./src/tool-format.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config --fix .",
    "lint:custom": "cd ../../apps/backend && lintcn lint --tsconfig ../../presentation/coffee-actions/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
