{
  "name": "@effect-coffee-shop/coffee-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./bun-server": "./src/bun-server.ts",
    "./web-handler": "./src/web-handler.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config --fix .",
    "lint:custom": "cd ../../apps/backend && lintcn lint --tsconfig ../../presentation/coffee-http/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/backend-host": "workspace:*",
    "@effect-coffee-shop/coffee-assistant": "workspace:*",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-coffee-shop/coffee-external-in-memory": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
