{
  "name": "@effect-coffee-shop/coffee-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent-auth": "./src/agent-auth.ts",
    "./agent-auth-data": "./src/agent-auth-data.ts",
    "./better-auth": "./src/better-auth.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config --fix .",
    "lint:custom": "cd ../../apps/backend && lintcn lint --tsconfig ../../presentation/coffee-auth/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/agent-auth": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect-coffee-shop/backend-host": "workspace:*",
    "@effect-coffee-shop/coffee-actions": "workspace:*",
    "@effect-coffee-shop/coffee-core": "workspace:*",
    "better-auth": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect-coffee-shop/coffee-external-sqlite": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "miniflare": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
