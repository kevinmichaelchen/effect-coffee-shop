{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "description": "Build distributable workspace artifacts.",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "build-storybook": {
      "description": "Build Storybook static assets.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["storybook-static/**"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "description": "Type-check each workspace.",
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "description": "Run standard workspace lint checks.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["^typecheck"]
    },
    "lint:custom": {
      "description": "Run workspace-specific custom lint rules.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt": {
      "description": "Format workspace files in place.",
      "cache": false,
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt:check": {
      "description": "Verify formatting without modifying files.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "description": "Run workspace test suites.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "env": ["COFFEE_POSTGRES_TEST_URL"]
    },
    "dev": {
      "description": "Run long-lived local development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "storybook": {
      "description": "Run Storybook development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "fallow": {
      "description": "Run repo-level Fallow codebase intelligence checks.",
      "inputs": ["$TURBO_DEFAULT$", ".fallowrc.jsonc", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#typecheck:infra": {
      "inputs": [
        "infra/alchemy/**",
        "alchemy.run.ts",
        "packages/**/*.ts",
        "packages/**/tsconfig.json",
        "packages/**/package.json"
      ],
      "outputs": []
    }
  },
  "globalDependencies": ["packages/.oxlintrc.json", "bunfig.toml"]
}
