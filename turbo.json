{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "description": "Build distributable workspace artifacts.",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "build-storybook": {
      "description": "Build Storybook static assets.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["storybook-static/**"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "description": "Type-check each workspace.",
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "description": "Run standard workspace lint checks.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["^typecheck"]
    },
    "lint:custom": {
      "description": "Run workspace-specific custom lint rules.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt": {
      "description": "Format workspace files in place.",
      "cache": false,
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt:check": {
      "description": "Verify formatting without modifying files.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "description": "Run workspace test suites.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "env": ["COFFEE_POSTGRES_TEST_URL"]
    },
    "dev": {
      "description": "Run long-lived local development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "storybook": {
      "description": "Run Storybook development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "//#typecheck:infra": {
      "inputs": [
        "infra/alchemy/**",
        "alchemy.run.ts",
        "packages/**/*.ts",
        "packages/**/tsconfig.json",
        "packages/**/package.json",
        "infra/turbo-cache/**",
        "apps/backend/**",
        "apps/ui/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.alchemy/**",
        "!**/node_modules/**"
      ],
      "outputs": []
    },
    "//#lint:infra": {
      "inputs": [
        "infra/**/*.ts",
        "infra/**/tsconfig.json",
        "alchemy.run.ts",
        "packages/**/*.ts",
        "packages/**/tsconfig.json",
        "packages/**/package.json"
      ],
      "outputs": []
    },
    "//#typecheck:tools": {
      "inputs": [
        "tsconfig.tools.json",
        "packages/**/*.ts",
        "packages/**/tsconfig.json",
        "packages/**/package.json",
        "packages/**/*.json",
        "apps/backend/*.ts",
        "apps/backend/*.json"
      ],
      "outputs": []
    },
    "//#lint:tools": {
      "inputs": ["packages/oxlint.config.ts", "packages/.oxlintrc.json", "tsconfig.tools.json"],
      "outputs": []
    },
    "//#fmt:check:root": {
      "inputs": [
        "package.json",
        "tsconfig.tools.json",
        "knip.jsonc",
        ".fallowrc.jsonc",
        "turbo.json",
        "infra/**",
        "packages/oxlint.config.ts",
        "packages/.oxlintrc.json"
      ],
      "outputs": []
    },
    "//#cf:test": {
      "description": "Alchemy Cloudflare stack smoke test under local emulation.",
      "inputs": [
        "infra/alchemy/**",
        "alchemy.run.ts",
        "apps/backend/**",
        "apps/ui/**",
        "packages/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.alchemy/**",
        "!**/node_modules/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#cache:test": {
      "description": "Turbo remote-cache worker integration test under local emulation.",
      "inputs": [
        "infra/turbo-cache/**",
        "packages/turbo-cache/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.alchemy/**",
        "!**/node_modules/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    }
  },
  "globalDependencies": [
    "packages/.oxlintrc.json",
    "bunfig.toml",
    ".node-version",
    "packages/oxlint.config.ts",
    "tsconfig.tools.json"
  ],
  "remoteCache": {
    "signature": true
  }
}
