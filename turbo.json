{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "description": "Build distributable workspace artifacts.",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "build-storybook": {
      "description": "Build Storybook static assets.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["storybook-static/**"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "description": "Type-check each workspace.",
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "description": "Run standard workspace lint checks.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["^typecheck"]
    },
    "lint:custom": {
      "description": "Run workspace-specific custom lint rules.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["@effect-coffee-shop/tooling#lint:custom:build"]
    },
    "fmt": {
      "description": "Format workspace files in place.",
      "cache": false,
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt:check": {
      "description": "Verify formatting without modifying files.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "description": "Run workspace test suites.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "env": ["COFFEE_POSTGRES_TEST_URL"]
    },
    "dev": {
      "description": "Run long-lived local development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "storybook": {
      "description": "Run Storybook development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "//#fmt:check:root": {
      "inputs": ["package.json", "knip.jsonc", ".fallowrc.jsonc", "turbo.json"],
      "outputs": []
    },
    "@effect-coffee-shop/tooling#lint:custom:build": {
      "description": "Build shared Go lint rules; rule changes invalidate all custom lint tasks.",
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@effect-coffee-shop/web#lint:custom": {
      "description": "UI custom lint uses its own apps/ui/.lintcn rules, not the shared tooling build.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["@effect-coffee-shop/web#lint:custom:build"]
    },
    "@effect-coffee-shop/ui-kit#lint:custom": {
      "dependsOn": ["@effect-coffee-shop/web#lint:custom:build"],
      "outputs": []
    },
    "@effect-coffee-shop/web#lint:custom:build": {
      "outputs": []
    },
    "@effect-coffee-shop/ui-kit#lint": {
      "description": "Kit design-system lint also reads the consuming app theme tokens.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "$TURBO_ROOT$/apps/ui/src/index.css"]
    }
  },
  "globalDependencies": [
    "packages/tooling/.oxlintrc.json",
    "bunfig.toml",
    ".node-version",
    "packages/tooling/oxlint.config.ts"
  ],
  "remoteCache": {
    "signature": true
  }
}
