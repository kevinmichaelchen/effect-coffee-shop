{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "description": "Build distributable workspace artifacts.",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "description": "Type-check each workspace.",
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "description": "Run standard workspace lint checks.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["^typecheck"]
    },
    "lint:fix": {
      "description": "Apply safe Oxlint fixes in each workspace.",
      "cache": false,
      "dependsOn": ["^typecheck"]
    },
    "lint:custom": {
      "description": "Run workspace-specific custom lint rules.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["@effect-coffee-shop/tooling#lint:custom:build"]
    },
    "fmt": {
      "description": "Format workspace files in place.",
      "cache": false,
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt:check": {
      "description": "Verify formatting without modifying files.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "description": "Run workspace test suites.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "dev": {
      "description": "Run long-lived local development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "//#fmt:check:root": {
      "inputs": ["package.json", ".fallowrc.jsonc", "turbo.json"],
      "outputs": []
    },
    "@effect-coffee-shop/tooling#lint:custom:build": {
      "description": "Build shared Go lint rules; rule changes invalidate all custom lint tasks.",
      "outputs": [],
      "outputLogs": "new-only"
    },
    "@effect-coffee-shop/web#lint:custom": {
      "description": "UI custom lint uses its own apps/ui/.lintcn rules, not the shared tooling build.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["@effect-coffee-shop/web#lint:custom:build"]
    },
    "@effect-coffee-shop/web#lint:custom:build": {
      "outputs": []
    }
  },
  "globalDependencies": ["bunfig.toml", ".node-version", "packages/tooling/oxlint*.ts"],
  "remoteCache": {
    "signature": true
  }
}
