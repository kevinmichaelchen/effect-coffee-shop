{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "description": "Build distributable workspace artifacts.",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!README.md"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "description": "Type-check each workspace.",
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "description": "Run standard workspace lint checks.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only",
      "dependsOn": ["^typecheck"]
    },
    "lint:fix": {
      "description": "Apply safe Oxlint fixes in each workspace.",
      "cache": false,
      "dependsOn": ["^typecheck"]
    },
    "fmt": {
      "description": "Format workspace files in place.",
      "cache": false,
      "outputs": [],
      "outputLogs": "new-only"
    },
    "fmt:check": {
      "description": "Verify formatting without modifying files.",
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test": {
      "description": "Run workspace test suites. Each runs Vitest with --fsModuleCache=false: the runs Turbo starts in parallel would share one module cache and race.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test:rivet": {
      "description": "Run the stack test with the model hosted on Rivet in local Docker.",
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test:watch": {
      "description": "Re-run Vitest on change.",
      "cache": false,
      "persistent": true
    },
    "dev": {
      "description": "Run long-lived local development servers.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "//#fmt:check:root": {
      "inputs": [
        "package.json",
        ".fallowrc.jsonc",
        "turbo.json",
        "prek.toml",
        "*.md",
        "docs/**/*.md",
        ".agents/**/*.md"
      ],
      "outputs": []
    },
    "//#fmt:root": {
      "cache": false
    },
    "//#fallow": {
      "description": "Audit architecture, dead code and health across the whole graph.",
      "inputs": ["$TURBO_DEFAULT$", "!**/README.md"],
      "outputs": [],
      "outputLogs": "new-only"
    }
  },
  "globalDependencies": [
    "bunfig.toml",
    "mise.toml",
    "packages/tooling/oxlint*.ts",
    "patches/*.patch"
  ],
  "remoteCache": {
    "signature": true
  }
}
