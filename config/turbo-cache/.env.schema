# Client configuration shared by both laptops. Keep secret values in a vault.
# @defaultRequired=true
# @defaultSensitive=false
# ---

# @type=url
TURBO_API=

TURBO_TEAM=coffee-shop

# Use the write token on trusted laptops and the read token in PR jobs.
# @sensitive @type=string(minLength=32,maxLength=256)
TURBO_TOKEN=

# Shared by trusted Turbo clients; never sent to the cache service.
# @sensitive @type=string(minLength=32)
TURBO_REMOTE_CACHE_SIGNATURE_KEY=
