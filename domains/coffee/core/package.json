{
  "name": "@effect-coffee-shop/coffee-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#domain/*": "./src/domain/*.ts",
    "#service/*": "./src/service/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./domain/*": "./src/domain/*.ts",
    "./service/*": "./src/service/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config --fix .",
    "lint:custom": "cd ../../../apps/backend && lintcn lint --tsconfig ../../domains/coffee/core/tsconfig.json",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
