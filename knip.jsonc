{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreDependencies": ["@effect/language-service", "oxlint", "oxlint-tsgolint"],
  "ignoreBinaries": ["portless"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@cloudflare/workers-types"],
    },
    "packages/coffee/domain": {
      "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "*.ts"],
    },
    "packages/coffee/application": {
      "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "*.ts"],
    },
    "packages/tooling": {
      "project": ["*.ts"],
    },
    "infra/alchemy": {
      "entry": ["alchemy.run.ts!", "cloudflare.ts!"],
      "project": ["*.ts!", "!*.test.ts!", "!vitest.config.ts!"],
      "ignoreDependencies": ["@effect-coffee-shop/web"],
    },
    "infra/turbo-cache": {
      "entry": ["aws.ts!", "cloudflare.ts!"],
      "project": ["*.ts!", "!*.test.ts!", "!vitest.config.ts!"],
    },
    "apps/ui": {
      "entry": ["src/worker.ts!", "src/entry.ts!"],
      "project": ["src/**/*.{ts,css}!", "*.ts"],
    },
    "packages/**": {
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/*.test.ts!",
        "!**/testing/**!",
        "!**/test-support.ts!",
      ],
    },
  },
  "tags": ["-public"],
  "cycles": {
    "dynamicImports": true,
  },
}
