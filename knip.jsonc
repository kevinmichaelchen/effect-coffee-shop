{
  "$schema": "./node_modules/knip/schema.json",
  // effect-tsrs reads this language-service plugin name from tsconfig to configure its diagnostics.
  // Knip does not credit oxlint/tsgolint invoked via our Bun interpreter wrapper.
  "ignoreDependencies": ["@effect/language-service", "oxlint", "oxlint-tsgolint"],
  // Portless is a developer-installed local reverse proxy, not application code.
  "ignoreBinaries": ["portless"],
  "workspaces": {
    ".": {
      // Ambient Cloudflare declarations used by the deployment toolchain.
      "ignoreDependencies": ["@cloudflare/workers-types"],
    },
    "packages/coffee/domain": { "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "*.ts"] },
    "packages/coffee/application": { "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "*.ts"] },
    "packages/ui-kit": {
      "project": ["src/**/*.ts!"],
    },
    "packages/tooling": {
      "project": ["*.ts"],
    },
    "infra/alchemy": {
      "entry": ["alchemy.run.ts!", "cloudflare.ts!"],
      "project": ["*.ts!", "!*.test.ts!", "!vitest.config.ts!"],
      // The UI is built by path (`Cloudflare.Website.Vite`), not imported; the dependency
      // gives Turbo the workspace edge that hashes UI changes into the smoke test.
      "ignoreDependencies": ["@effect-coffee-shop/web"],
    },
    "infra/turbo-cache": {
      "entry": ["aws.ts!", "cloudflare.ts!"],
      "project": ["*.ts!", "!*.test.ts!", "!vitest.config.ts!"],
    },
    "apps/ui": {
      // The Website's Worker, deployed by path from the Alchemy stack.
      "entry": ["src/worker.ts!", "src/entry.ts!"],
      "project": ["src/**/*.{ts,css}!", "!src/**/*.test.ts!", "*.ts"],
    },
    "packages/**": {
      "project": [
        "**/*.{ts,tsx,js,jsx}!",
        "!**/*.test.ts!",
        "!**/testing/**!",
        "!**/test-support.ts!",
      ],
    },
  },
  // Retain explicitly documented types required by exported signatures.
  "tags": ["-public"],
  // Include dynamic imports when checking for circular dependencies.
  "cycles": { "dynamicImports": true },
}
