# Deployment configuration. Values come from the shell, a local .env.local,
# or a Varlock provider configured in a local override.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# @required @type=string
CACHE_TEAM=coffee-shop

# @required @sensitive @type=string(minLength=32,maxLength=256)
CACHE_WRITE_TOKEN=

# @required @sensitive @type=string(minLength=32,maxLength=256)
CACHE_READ_TOKEN=

# @type=number(min=1,max=94371840)
CACHE_MAX_BYTES=67108864

# Required for AWS deployment: hostname in a public Route 53 hosted zone.
# @type=string
CACHE_DOMAIN=

# Cloud credentials are used by Alchemy during deployment, not by cache clients.
CLOUDFLARE_ACCOUNT_ID=
# @sensitive
CLOUDFLARE_API_TOKEN=
AWS_PROFILE=
AWS_REGION=
