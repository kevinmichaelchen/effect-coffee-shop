{
  "name": "@effect-coffee-shop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#App": "./src/app/App.tsx",
    "#app/*": "./src/app/*",
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev --ci --no-open --host 0.0.0.0 --port 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project=storybook",
    "test:watch": "vitest --project=storybook",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json && tsgo --noEmit -p tsconfig.node.json",
    "build": "vite build",
    "check": "bun run typecheck && bun run lint && bun run lint:custom && bun run fmt:check && bun run knip && bun run test && bun run build",
    "lint": "oxlint -c .oxlintrc.json . && eslint .",
    "lint:custom": "lintcn lint --tsconfig tsconfig.app.json",
    "lint:custom:build": "lintcn build",
    "lint:custom:list": "lintcn list",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip --files --exports --no-config-hints",
    "preview": "vite preview"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@headlessui/react": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-label": "catalog:",
    "@radix-ui/react-progress": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-visually-hidden": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-client": "catalog:",
    "@tanstack/ai-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "effect": "catalog:",
    "lucide-react": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
