{
  "name": "@effect-coffee-shop/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsrs --noEmit -p tsconfig.app.json && tsrs --noEmit -p tsconfig.node.json",
    "build": "vite build",
    "check": "bun run typecheck && bun run lint && bun run lint:custom && bun run fmt:check && bun run test && bun run build",
    "lint": "effect-tsrs oxlint -c ../../packages/tooling/oxlint.ui.config.ts --disable-nested-config .",
    "lint:fix": "effect-tsrs oxlint -c ../../packages/tooling/oxlint.ui.config.ts --disable-nested-config --fix .",
    "lint:custom": "lintcn lint --tsconfig tsconfig.app.json",
    "lint:custom:build": "lintcn build",
    "lint:custom:list": "lintcn list",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "preview": "vite preview",
    "lint:custom:run": "lintcn lint"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect-coffee-shop/coffee-auth": "workspace:*",
    "@effect-coffee-shop/coffee-domain": "workspace:*",
    "@effect-coffee-shop/ui-kit": "workspace:*",
    "@effect/platform-browser": "catalog:",
    "@foldkit/ui": "catalog:",
    "@huggingface/tokenizers": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@yielded/auth": "catalog:",
    "@yielded/auth-simplewebauthn": "catalog:",
    "@yielded/sync": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "onnxruntime-web": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@yielded/effect-tsrs": "catalog:",
    "happy-dom": "catalog:",
    "lintcn": "catalog:",
    "onnxruntime-node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
