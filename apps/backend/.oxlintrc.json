{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node"],
  "jsPlugins": ["@mpsuesser/oxlint-plugin-effect"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "effect/avoid-any": "error",
    "effect/avoid-direct-json": "error",
    "effect/avoid-direct-tag-checks": "error",
    "effect/avoid-process-env": "error",
    "effect/avoid-sync-fs": "error",
    "effect/casting-awareness": "error",
    "effect/effect-catchall-default": "error",
    "effect/prefer-redacted-config": "error",
    "effect/require-effect-concurrency": "error",
    "effect/throw-in-effect-gen": "error",
    "effect/use-console-service": "error",
    "effect/use-filesystem-service": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "complexity": ["error", { "max": 10 }],
        "max-depth": ["error", { "max": 4 }],
        "max-lines": ["error", { "max": 220, "skipBlankLines": true, "skipComments": true }],
        "max-lines-per-function": [
          "error",
          { "max": 75, "skipBlankLines": true, "skipComments": true }
        ],
        "max-params": ["error", { "max": 5 }],
        "max-statements": ["error", { "max": 18 }],
        "node/no-process-env": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@effect/platform-bun",
              "@effect/platform-bun/*",
              "@effect/platform-node",
              "@effect/platform-node/*",
              "bun:*",
              "node:*"
            ]
          }
        ],
        "promise-function-async": "error"
      }
    },
    {
      "files": ["src/platforms/cloudflare/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@effect/platform-bun",
              "@effect/platform-bun/*",
              "@effect/platform-node",
              "@effect/platform-node/*",
              "bun:*",
              "node:*",
              "#application/use-cases/*",
              "#application/ports/*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/platforms/bun/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["#application/use-cases/*", "#application/ports/*"]
          }
        ]
      }
    },
    {
      "files": ["src/runtime/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/platforms/bun/**/main.ts", "src/platforms/bun/**/*-main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["#application/use-cases/*", "#application/ports/*"]
          }
        ]
      }
    },
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["../../src/*", "../src/*", "node:*"] }]
      }
    }
  ]
}
