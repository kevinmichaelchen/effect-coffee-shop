{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "node"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "no-bitwise": "error",
    "no-plusplus": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "complexity": ["error", { "max": 10 }],
        "max-depth": ["error", { "max": 4 }],
        "max-lines": ["error", { "max": 220, "skipBlankLines": true, "skipComments": true }],
        "max-lines-per-function": [
          "error",
          { "max": 75, "skipBlankLines": true, "skipComments": true }
        ],
        "max-params": ["error", { "max": 5 }],
        "max-statements": ["error", { "max": 18 }],
        "node/no-process-env": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@effect/platform-bun",
              "@effect/platform-bun/*",
              "@effect/platform-node",
              "@effect/platform-node/*",
              "bun:*",
              "node:*"
            ]
          }
        ],
        "promise-function-async": "error"
      }
    },
    {
      "files": ["src/cloudflare/**/*.ts", "src/composition/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@effect/platform-bun",
              "@effect/platform-bun/*",
              "@effect/platform-node",
              "@effect/platform-node/*",
              "bun:*",
              "node:*",
              "#service/use-cases/*",
              "#service/ports/*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/bun/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["#service/use-cases/*", "#service/ports/*"]
          }
        ]
      }
    },
    {
      "files": ["src/runtime/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/bun/**/main.ts", "src/bun/**/*-main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["#service/use-cases/*", "#service/ports/*"]
          }
        ]
      }
    },
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["../../src/*", "../src/*", "node:*"] }]
      }
    }
  ]
}
