{
  "name": "@effect-coffee-shop/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run http",
    "http": "bun run src/bun/http-main.ts",
    "cli": "bun run src/bun/cli-main.ts",
    "mcp:stdio": "bun run src/bun/mcp-stdio-main.ts",
    "mcp:http": "bun run src/bun/mcp-http-main.ts",
    "dev:local:api": "bun run src/bun/local-backend-main.ts",
    "db:auth:schema": "bun run --cwd ../../packages/coffee/external/sqlite auth:schema",
    "db:check": "bun run --cwd ../../packages/coffee/external/sqlite db:check",
    "db:draft": "bun run --cwd ../../packages/coffee/external/sqlite db:draft",
    "db:format": "bun run --cwd ../../packages/coffee/external/sqlite db:format",
    "db:generate": "bun run --cwd ../../packages/coffee/external/sqlite db:generate",
    "db:migrate": "bun run --cwd ../../packages/coffee/external/sqlite db:migrate",
    "typecheck": "tsgo --noEmit",
    "lint": "bun --bun oxlint --disable-nested-config .",
    "lint:fix": "bun --bun oxlint --disable-nested-config --fix .",
    "lint:custom": "lintcn lint --tsconfig tsconfig.json",
    "lint:custom:build": "lintcn build",
    "lint:custom:list": "lintcn list",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run lint:custom && bun run fmt:check && bun run test",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect-coffee-shop/coffee-runtime-aws": "workspace:*",
    "@effect-coffee-shop/coffee-runtime-bun": "workspace:*",
    "@effect-coffee-shop/coffee-runtime-cloudflare": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "lintcn": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
