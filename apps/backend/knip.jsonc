{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  // Focus on application and test code only.
  "entry": [
    "src/bun/http-main.ts!",
    "src/bun/cli-main.ts!",
    "src/bun/mcp-stdio-main.ts!",
    "src/bun/mcp-http-main.ts!",
    "src/cloudflare/mcp-miniflare-worker.ts",
    "src/**/*.test.ts",
    "test/**/*.test.ts",
  ],

  "project": ["src/**/*.ts!", "test/**/*.ts"],

  "ignoreDependencies": ["find-up", "ink", "react", "tar"],
}
